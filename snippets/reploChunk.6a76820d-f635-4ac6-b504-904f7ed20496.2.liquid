"f57c9a5c-7c21-40c0-91dd-81d257c8bfe1" class="r-117wmo1"><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/cb307e6f-d5a4-4243-b8b9-591e1893b913?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/93ef9789-2b1d-452f-8cac-5be7187a708d?width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/93ef9789-2b1d-452f-8cac-5be7187a708d?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/93ef9789-2b1d-452f-8cac-5be7187a708d" class="r-11er7fs" loading="eager"/></picture><picture data-rid="f1e509df-693b-4fdd-8427-727ab82e7f2a" class="r-1syrma8"><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/de14ac82-f850-4896-949a-d97d55eb8696?width=200" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/de14ac82-f850-4896-949a-d97d55eb8696?width=200" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/de14ac82-f850-4896-949a-d97d55eb8696?width=240" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/de14ac82-f850-4896-949a-d97d55eb8696" class="r-l045v4" loading="eager"/></picture></div><div data-rid="2d791a39-b9ae-4fe2-a595-44b97a7c0ae1" class="r-lb4wet"><div data-rid="8b42f37e-1a07-4f6f-97bf-3aab413294b0" class="r-yqukbb"><div data-rid="e3c6f395-11cc-45cd-af49-b9cc6a43bbef" class="r-18sic8j"><div data-rid="f8c96cdf-5651-4147-93e0-0ea3f0fbfc91" class="r-v3wqms alchemy-rte"><span style="width:100%"><p>5</p></span></div></div><div data-rid="7c0e13d0-b7ab-4633-a3c0-45bcde554da1" class="r-ruwt4s alchemy-rte"><span style="width:100%"><p>Helps <span style="color: #33ACDCFF">Relieve Stress</span></p></span></div></div><div data-rid="ac29d1f3-5734-4eaa-a632-0e0347b0890b" class="r-dstfi0 alchemy-rte"><span style="width:100%"><p>One of the biggest reasons shower steamers have become a self-care essential is their ability to transform your mood. The comforting scents of essential oils can help create a sense of calm and provide a momentary escape from everyday stressors. Whether you use them in the morning to start your day feeling refreshed or at night to unwind before bed, they make self-care feel simple, accessible, and enjoyable.</p></span></div></div></div></div></div><div data-rid="8ad4469d-e92f-45f7-b9f8-daf1a9fc4148" class="r-11kitl6"><div data-rid="d1cf2786-b199-456c-a3ae-c59a26b8133e" class="r-pv9o30"><div data-rid="fd625074-0043-4a05-b4b8-40df5e3e3462" class="r-13wj44b"><script>
(function () {
  // Selling plan value → day count
  const PLAN_DAYS = {
    "747634784": "15",
    "747667552": "30",
    "747700320": "60"
  };

  function updateText(days) {
    const el = document.querySelector("[data-estimated-time-text] p");
    if (!el) return;
    el.textContent = el.textContent.replace(/Every \d+ Days/i, "Every " + days + " Days");
  }

  // Strategy 1: native change/input event delegation (bubbles from any select)
  document.addEventListener("change", function (e) {
    if (!e.target.closest("[data-select-options]")) return;
    const sel = e.target;
    const match = sel.options[sel.selectedIndex]?.text.match(/\d+/);
    if (match) updateText(match[0]);
  });
  document.addEventListener("input", function (e) {
    if (!e.target.closest("[data-select-options]")) return;
    const sel = e.target;
    const match = sel.options[sel.selectedIndex]?.text.match(/\d+/);
    if (match) updateText(match[0]);
  });

  // Strategy 2: watch the hidden selling_plan input attribute for Replo-driven updates
  function watchSellingPlan() {
    const input = document.querySelector("input[name='selling_plan']");
    if (!input) return false;
    new MutationObserver(function () {
      const days = PLAN_DAYS[input.getAttribute("value")];
      if (days) updateText(days);
    }).observe(input, { attributes: true, attributeFilter: ["value"] });
    return true;
  }

  // Strategy 3: poll the select value as a fallback (catches React-controlled updates)
  let lastValue = null;
  setInterval(function () {
    const sel = document.querySelector("[data-select-options]");
    if (!sel || sel.value === lastValue) return;
    lastValue = sel.value;
    const days = PLAN_DAYS[sel.value];
    if (days) updateText(days);
  }, 300);

  // Wait for DOM if elements aren't ready yet
  function init() {
    const ready = !!document.querySelector("[data-select-options]");
    if (ready) watchSellingPlan();
    return ready;
  }

  if (!init()) {
    const observer = new MutationObserver(function () {
      if (init()) observer.disconnect();
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }
})();
</script></div><div data-rid="7b18b8a9-ba0a-4879-92bb-e898ddc50da9" class="r-nb6h3h"><style>
