6-4465-87a8-2c8c2f1df263" class="r-1xvpcp5"><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/cb307e6f-d5a4-4243-b8b9-591e1893b913?width=820" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/93ef9789-2b1d-452f-8cac-5be7187a708d?width=1024" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/93ef9789-2b1d-452f-8cac-5be7187a708d?width=1800" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/93ef9789-2b1d-452f-8cac-5be7187a708d" class="r-st3fva" loading="eager"/></picture><picture data-rid="45d205f0-60bc-4abd-bbef-8ff6f91f2455" class="r-1f6bhmc"><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/de14ac82-f850-4896-949a-d97d55eb8696?width=200" media="(max-width: 640px)"/><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/de14ac82-f850-4896-949a-d97d55eb8696?width=200" media="(min-width: 641px) and (max-width: 1024px)"/><source srcSet="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/de14ac82-f850-4896-949a-d97d55eb8696?width=240" media="(min-width: 1025px) and (max-width: 2400px)"/><img src="https://assets.replocdn.com/projects/34ae5ee7-7771-4d32-b6a0-7984780e4362/de14ac82-f850-4896-949a-d97d55eb8696" class="r-18jd46a" loading="eager"/></picture></div><div data-rid="88b0f029-2e8e-4d8e-97ba-c3b86183beea" class="r-1w9hk9y"><div data-rid="1d5763f8-6642-4eb1-a271-2297f7b3675c" class="r-n4mjq8"><div data-rid="75edc1fc-5007-4de4-8222-9c04c4472aa8" class="r-l8cc8y"><div data-rid="fb6ecef4-a266-48b7-872e-2f41fbc501ad" class="r-afy2zl alchemy-rte"><span style="width:100%"><p>5</p></span></div></div><div data-rid="94286b47-b860-48b2-b77c-c00b19d17fa1" class="r-1ik7v2w alchemy-rte"><span style="width:100%"><p>Helps <span style="color: #33ACDCFF">Relieve Stress</span></p></span></div></div><div data-rid="3c192f21-24d4-4a47-83f7-0ee9fc88da05" class="r-1vft5dh alchemy-rte"><span style="width:100%"><p>One of the biggest reasons shower steamers have become a self-care essential is their ability to transform your mood. The comforting scents of essential oils can help create a sense of calm and provide a momentary escape from everyday stressors. Whether you use them in the morning to start your day feeling refreshed or at night to unwind before bed, they make self-care feel simple, accessible, and enjoyable.</p></span></div></div></div></div></div><div data-rid="d5efad13-913c-4c47-ab73-8afbeb2e8449" data-alchemy-url-hashmark="buy-box" tabindex="-1" id="buy-box" data-alchemy-url-hashmark-ignore="true" class="r-p7s82w"><div data-rid="734d4d77-70c7-475e-b891-d2c4dc4a38c4" class="r-fqzrmu"><script>
(function () {
  // Selling plan value → day count
  const PLAN_DAYS = {
    "747634784": "15",
    "747667552": "30",
    "747700320": "60"
  };

  function updateText(days) {
    const el = document.querySelector("[data-estimated-time-text] p");
    if (!el) return;
    el.textContent = el.textContent.replace(/Every \d+ Days/i, "Every " + days + " Days");
  }

  // Strategy 1: native change/input event delegation (bubbles from any select)
  document.addEventListener("change", function (e) {
    if (!e.target.closest("[data-select-options]")) return;
    const sel = e.target;
    const match = sel.options[sel.selectedIndex]?.text.match(/\d+/);
    if (match) updateText(match[0]);
  });
  document.addEventListener("input", function (e) {
    if (!e.target.closest("[data-select-options]")) return;
    const sel = e.target;
    const match = sel.options[sel.selectedIndex]?.text.match(/\d+/);
    if (match) updateText(match[0]);
  });

  // Strategy 2: watch the hidden selling_plan input attribute for Replo-driven updates
  function watchSellingPlan() {
    const input = document.querySelector("input[name='selling_plan']");
    if (!input) return false;
    new MutationObserver(function () {
      const days = PLAN_DAYS[input.getAttribute("value")];
      if (days) updateText(days);
    }).observe(input, { attributes: true, attributeFilter: ["value"] });
    return true;
  }

  // Strategy 3: poll the select value as a fallback (catches React-controlled updates)
  let lastValue = null;
  setInterval(function () {
    const sel = document.querySelector("[data-select-options]");
    if (!sel || sel.value === lastValue) return;
    lastValue = sel.value;
    const days = PLAN_DAYS[sel.value];
    if (days) updateText(days);
  }, 300);

  // Wait for DOM if elements aren't ready yet
  function init() {
    const ready = !!document.querySelector("[data-select-options]");
    if (ready) watchSellingPlan();
    return ready;
  }

  if (!init()) {
    const observer = new MutationObserver(function () {
      if (init()) observer.disconnect();
    });
    observer.observe(document.body, { childList: true, subtree: true });
  }
})();
</script></div><div data-rid="cd76f3ef-a7cd-464f-b6cf-4035e4f1210e" class="r-1wdouai"><style>
