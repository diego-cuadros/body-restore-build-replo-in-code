   function initCustomVideos() {
    document.querySelectorAll('div[data-ucg="video"]').forEach((videoBox) => {
 
        // Duplicate events avoid
        if (videoBox.dataset.videoInitialized) return;
        videoBox.dataset.videoInitialized = "true";
 
        const playWrapper = videoBox.querySelector('div[data-playbtn="wrapper"]');
        const video = videoBox.querySelector('video');
 
        if (!playWrapper || !video) return;
 
        // Play button click
        playWrapper.addEventListener('click', (e) => {
            e.stopPropagation();
 
            playWrapper.style.display = 'none';
 
            video.play();
        });
 
        // Video click => toggle play/pause
        video.addEventListener('click', () => {
 
            if (video.paused) {
                video.play();
                playWrapper.style.display = 'none';
            } else {
                video.pause();
                playWrapper.style.display = 'flex';
            }
 
        });
 
        // Video end
        video.addEventListener('ended', () => {
            playWrapper.style.display = 'flex';
        });
    });
}
 
// Initial run
initCustomVideos();
 
// Replo dynamic content observer
const observer = new MutationObserver(() => {
    initCustomVideos();
});
 
observer.observe(document.body, {
    childList: true,
    subtree: true
});
</script></div></div></div><style>@import url(https://fonts.googleapis.com/css2?family=Montserrat:wght@100;200;300;400;500;600;700;800;900;950&family=Raleway:wght@100;200;300;400;500;600;700;800;900;950)</style></div>
