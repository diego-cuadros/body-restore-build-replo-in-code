      </div>
      <div class="lock-container">
        <div class="lock"></div>
        <div class="text">3 Bags</div>
      </div>
    </div>
    <div class="name">{{ block.settings.freetext3 }}</div>
  </div>
  <div class="featured-gift-container block--6">
