          {% render 'lock-svg' %}
        </div>
        <div class="text">2 Bags</div>
      </div>
    </div>
    <div class="name">{{ block.settings.freetext2 }}</div>
  </div>
  <div class="featured-gift-container block--3">
    <div class="image-container">
      {% if block.settings.bagbadge3 != blank %}
        <div class="progress-badge-text">{{ block.settings.bagbadge3 }}</div>
