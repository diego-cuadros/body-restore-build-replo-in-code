<div class="gift-product-container pack4">
  <div class="featured-gift-container block--1">
    <div class="image-container">
      {% if block.settings.bagbadge1 != blank %}
        <div class="progress-badge-text">{{ block.settings.bagbadge1 }}</div>
      {% endif %}
      <div class="image">
        <img src="{{ block.settings.freeimage1 | img_url : 'master' }}">
      </div>
      <div class="lock-container">
        <div class="lock">
          {% render 'lock-svg' %}
        </div>
        <div class="text">1 Bag</div>
      </div>
    </div>
    <div class="name">{{ block.settings.freetext1 }}</div>
  </div>
  <div class="featured-gift-container block--2">
    <div class="image-container">
      {% if block.settings.bagbadge2 != blank %}
