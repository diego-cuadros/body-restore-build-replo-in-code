{% style %}
   .block--{{ block.id }} a{width:fit-content;display:flex;}
   .block--{{ block.id }} .viral-button{padding:16px 32px;line-height:1.2;border-radius:4px;min-width:240px;width:fit-content;margin-bottom:{{block.settings.margin_bottom}}px;background-color:{{block.settings.bg_color}};color:{{block.settings.color}};font-size:{{block.settings.font_size}}px;font-weight:{{ block.settings.font_weight }};text-align:center;}
   .block--{{ block.id }} .viral-button:hover{background-color:{{block.settings.hbg_color}};color:{{block.settings.hcolor}};}

  @media screen and (max-width:768px){
  .block--{{ block.id }} .viral-button{margin-bottom:{{block.settings.mobile_margin_bottom}}px;background-color:{{block.settings.mobile_bg_color}};color:{{block.settings.mobile_color}};font-size:{{block.settings.mobile_font_size}}px;}
  .block--{{ block.id }} .viral-button:hover{background-color:{{block.settings.mobile_hbg_color}};color:{{block.settings.mobile_hcolor}};}
  }
{% endstyle %}


<div class="block--{{ block.id }}">
  <a href="{{ block.settings.link }}">
    <div class="viral-button">{{ block.settings.button }}</div>
  </a>
</div>
{% schema %}
{
      "name": "Button",
      "settings": [
        {
          "type":"text",
          "id":"button",
          "label":"Button Label"
        },
        {
          "type":"url",
          "id":"link",
          "label":"Button Link"
        },
        {
          "type": "range",
          "id": "font_size",
          "min": 1,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 20,
          "label":"Font Size"
        },
        {
          "type": "range",
          "id": "font_weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default": 400,
          "label":"Font Weight"
        },
        {
          "type":"header",
          "content":"Desktop View Customization"
        },
        {
          "type":"color",
          "label":"Background Color",
          "id":"bg_color"
        },
        {
          "type": "color",
          "id": "color",
          "label":"Color"
        },
        {
          "type":"header",
          "content":"hover Button Color"
        },
        {
          "type":"color",
          "label":"Hover Background Color",
          "id":"hbg_color"
        },
        {
          "type": "color",
          "id": "hcolor",
          "label":"Hover Color"
        },
        {
          "type":"header",
          "content":"Mobile View Customization"
        },
        {
          "type": "range",
          "id": "mobile_font_size",
          "min": 1,
          "max": 100,
          "step": 1,
          "unit": "px",
          "default": 20,
          "label":"Font Size"
        },
        {
          "type":"color",
          "label":"Mobile Background Color",
          "id":"mobile_bg_color"
        },
        {
          "type": "color",
          "id": "mobile_color",
          "label":"Mobile Color"
        },
        {
          "type":"header",
          "content":"hover Button Color"
        },
        {
          "type":"color",
          "label":"Hover Mobile Background Color",
          "id":"mobile_hbg_color"
        },
        {
          "type": "color",
          "id": "mobile_hcolor",
          "label":"Hover Mobile Color"
        },
        {
          "type":"header",
          "content":"Bottom Spacing Customization"
        },
        {
          "type": "range",
          "id": "margin_bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 10,
          "label":"Margin Bottom"
        },
        {
          "type": "range",
          "id": "margin_margin_bottom",
          "min": 0,
          "max": 100,
          "step": 1,
          "default": 10,
          "label":"Mobile Margin Bottom"
        }
      ],
    "presets": [
      {
        "name":"button"
      }
    ]
    }
{% endschema %}