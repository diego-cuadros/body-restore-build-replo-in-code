<div class="video-item">
  <div class="media-container">
    <div class="media">
      <img src="{{ block.settings.image | img_url : 'master' }}">
      <div class="play-btn">
        <div class="icon">
          <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 110 110">
            <g id="Group_1" data-name="Group 1" transform="translate(-597 675)">
              <rect id="Rectangle_1" data-name="Rectangle 1" width="110" height="110" transform="translate(597 -675)" fill="#fff" opacity="0"></rect>
              <path id="Polygon_1" data-name="Polygon 1" d="M55,0l55,77H0Z" transform="translate(697 -675) rotate(90)" fill="currentColor"></path>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
  <div class="main-popup-container">
    <div class="popup-container cross-popup">
      <div class="video-container">
        <div class="cross-popup cross-popup-icon">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink"
            aria-hidden="true"
            role="img"
            class="iconify iconify--ic"
            width="100%"
            height="100%"
            preserveAspectRatio="xMidYMid meet"
            viewBox="0 0 24 24"
          >
            <path fill="currentColor" d="M18.3 5.71a.996.996 0 0 0-1.41 0L12 10.59L7.11 5.7A.996.996 0 1 0 5.7 7.11L10.59 12L5.7 16.89a.996.996 0 1 0 1.41 1.41L12 13.41l4.89 4.89a.996.996 0 1 0 1.41-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4z"></path>
          </svg>
        </div>
        <div class="video">
          {{-
            block.settings.video
            | video_tag:
              controls: true,
              playsinline: true,
              muted: false,
              autoplay: false,
              loop: true,
              preload: 'metadata',
              class: 'video-meta',
              poster: ''
            | replace: '<img ', '<img loading="lazy" '
          -}}
        </div>
      </div>
    </div>
    <!-- <div class="background-cross cross-popup"></div> -->
  </div>
</div>

{% schema %}
{
  "name": "Video",
  "settings": [
    {
      "type":"image_picker",
      "id":"image",
      "label":"Image"
    },
    {
      "type":"video",
      "id":"video",
      "label":"Video"
    }
  ],
  "presets": [
    {
      "name":"Video",
    }
  ]
}
{% endschema %}
