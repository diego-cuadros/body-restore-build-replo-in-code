    "custom_media_with_content_3cf86F": {
      "type": "custom-media-with-content",
      "blocks": {
        "heading_8YxGJU": {
          "type": "heading",
          "settings": {
            "heading": "You can finally give gifts people actually use",
            "text_color": "#0c2331",
