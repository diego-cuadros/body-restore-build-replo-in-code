          "settings": {
            "review_box_bg": "#e2edec",
            "review_box_border_color": "#00bcae",
            "img": "shopify://shop_images/BR_image_1.png",
            "review_text": "<p>“These tablets worked surprisingly well. The scent is real, not fake or overpowering. It’s exactly what I needed after long days. Pure essential oil experience in your shower.”</p>",
