        },
        "key_item_YLFjN3": {
          "type": "key_item",
          "settings": {
            "position": "left",
            "title": "Incredibly convenient",
            "bgcolor": "#dda4b6",
            "color": "#ffffff",
            "content": "<p>Just place it, steam it, breathe it. It's the easiest way to upgrade your daily routine.</p>",
            "dashed_height": 200,
            "dashed_position": 34,
            "enabletop": "bottom",
            "circle_bg": "#ceff64"
          }
        },
        "key_item_3XBtLQ": {
          "type": "key_item",
          "settings": {
            "position": "left",
            "title": "Natural Ingredients",
            "bgcolor": "#72c0b6",
            "color": "#ffffff",
            "content": "<p>Harsh chemicals don't belong in your shower-or down your drain. We use clean, skin-safe ingredients that dissolve completely, leaving nothing behind but calming scents.</p>",
            "dashed_height": 100,
            "dashed_position": 34,
            "enabletop": "top",
            "circle_bg": "#ceff64"
          }
        },
        "key_item_cXbY48": {
          "type": "key_item",
          "settings": {
            "position": "right",
            "title": "Ultra-versatile",
            "bgcolor": "#ecc12e",
            "color": "#ffffff",
            "content": "<p>Our steamers are small, portable, and travel-friendly. Toss a few in your bag, and take your personal spa on the go.</p>",
            "dashed_height": 200,
            "dashed_position": 25,
            "enabletop": "bottom",
            "circle_bg": "#ceff64"
          }
        },
        "key_item_gydjXC": {
