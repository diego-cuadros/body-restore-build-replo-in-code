        "content_EWRcmj": {
          "type": "content",
          "settings": {
            "content": "<p>Delivers tension relief, clear breathing, and instant calm in the time it takes to shower.</p>",
            "color": "#0c2331",
            "font_size": 16,
            "mobile_font_size": 14,
            "font_weight": 400,
            "padding_bottom": 60,
            "mobile_padding_bottom": 40
