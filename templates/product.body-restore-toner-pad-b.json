    "n_faq_M7hUjR": {
      "type": "n_faq",
      "blocks": {
        "faq_grid_yDNGke": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What makes Body Restore different?",
            "faq_title_desc": "<p>Unlike liquid chemical toners, these essence-soaked pads deliver consistent, even coverage — combining exfoliation, hydration, and brightening in one quick step inspired by Korean skin rituals.</p>"
          }
        },
        "faq_grid_pfLeY6": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What are the key ingredients?",
            "faq_title_desc": "<p>Each pad is infused with Bakuchiol and Niacinamide, two powerhouse ingredients inspired by Korean skincare. Bakuchiol helps smooth and firm skin without irritation, while Niacinamide brightens, refines pores, and strengthens the skin barrier.</p>"
          }
        },
        "faq_grid_kbz4JE": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Can I use them with other skincare products?",
            "faq_title_desc": "<p>Absolutely. They layer seamlessly under serums, moisturizers, and SPF. Think of them as your first step toward that fresh, glass-skin glow.</p>"
          }
        },
        "faq_grid_RrCEtR": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Where is it made and is it safe?",
            "faq_title_desc": "<p>Body Restore toner pads are proudly made in Korea, following the same high standards that define advanced K-beauty skincare. Each formula is tested, cruelty-free, and designed for daily, gentle use on all skin types. The ingredients are clean, non-irritating, and free from harsh alcohols or synthetic fragrances.</p>"
          }
        },
        "faq_grid_AnELPC": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Are they suitable for sensitive skin?",
            "faq_title_desc": "<p>Yes. The formula is alcohol-free, fragrance-free, and dermatologist-tested. Bakuchiol offers retinol-like results without irritation, while Niacinamide helps calm and strengthen your skin barrier.</p>"
          }
        },
        "faq_grid_3aE7Xe": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "How long does shipping take?",
            "faq_title_desc": "<p>Orders are processed quickly and typically arrive within 3 to 5 business days. You’ll receive a tracking number once your order ships so you can follow it right to your door.</p>"
          }
        },
        "faq_grid_wzXkHV": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What is your return policy if I’m not satisfied?",
            "faq_title_desc": "<p>We offer a 30-day money-back guarantee if you’re not fully satisfied. </p>"
          }
        }
      },
