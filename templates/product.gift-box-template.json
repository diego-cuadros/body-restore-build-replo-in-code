    "is_faq_XwUHMp": {
      "type": "is--faq",
      "blocks": {
        "faq_grid_RPP3JL": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Is it safe for pets?",
            "faq_title_desc": "<p>Yes! Our shower bombs are safe to be used around your pets :)</p>"
          }
        },
        "faq_grid_fapPic": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What makes Body Restore different?",
            "faq_title_desc": "<p>We use organic essential oils & natural ingredients from the United Kingdom to create the aromatherapy home spa experience. We ensure that our tablets are crafted with perfection, packaged to ensure extended shell life and are made in the most eco-friendly environment.</p>"
          }
        },
        "faq_grid_iywAgV": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What are the best practices in using these shower tablets?",
            "faq_title_desc": "<p>We recommend to use one tablet per shower or two tablets to double the strength if needed. Use in hot shower and make sure it’s not submerged in water but rather placed under the shower stream of hot water.</p>"
          }
        },
        "faq_grid_LejEdk": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Will these tablet make floor slippery and create stains/draing clogs",
            "faq_title_desc": "<p>These shower tablets will not make the floor slippery and unlike other branded shower tablets with petals, it will dissolve smoothly to create a no mess no drain clog experience.</p>"
          }
        },
        "faq_grid_NV8LNa": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Can these shower tablets be used as a bath bombs?",
            "faq_title_desc": "<p>We do not recommend these used as bath bombs. These tablets work best when not submerged in water, making it perfect for the shower experience. However, you can place the shower tablet on the side of the bath tub and it will activate the aromatherapy with a sprinkle of water contact.</p>"
          }
        },
        "faq_grid_FD4jTU": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Do these showe tablets have a shelf life?",
            "faq_title_desc": "<p>These shower tablets are individually foil wrapped to ensure maximum shell life. We recommend using the shower steamers within a year for the best experience.</p>"
          }
        },
        "faq_grid_jcNnh7": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "How long does each shower tabet last?",
            "faq_title_desc": "<p>Each tablet duration can vary for each person as shower water pressure can play a role in the longevity of each tablet. It can range from 10 minutes to 30 minutes.</p>"
          }
        },
        "faq_grid_Bimrd6": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Are the shower steamers safe to use during the pregnancy?",
            "faq_title_desc": "<p>Aromatherapy is generally safe for pregnant women. However, please do consult a doctor before use to confirm.</p>"
          }
        },
        "faq_grid_7PVCk9": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "How long does shipping take?",
            "faq_title_desc": "<p>Shipping generally takes 5-7 business days. However, COVID-19 has played a role in some slight shipping delays. It make take an additional few days to arrive.</p>"
          }
        },
        "faq_grid_jhegB9": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What is the return policy?",
            "faq_title_desc": "<p>We strive our best to ensure the best customer experience. We're so confident you'll love our products that we offer a 30 day refund policy.</p>"
          }
        }
      },
