    "n_faq_M7hUjR": {
      "type": "n_faq",
      "blocks": {
        "faq_grid_b9UgQU": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What makes Body Restore different?",
            "faq_title_desc": "<p>Body Restore is proudly made in the USA using premium, natural ingredients and clean formulations. We never use fillers, synthetic fragrances, or harsh additives. Each product features nutrient-rich components like grass-fed tallow and goat milk, crafted in small batches for quality, safety, and visible results.</p>"
          }
        },
        "faq_grid_icwWj7": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What is Goat Milk Soap made of?",
            "faq_title_desc": "<p>Our Goat Milk Soap is crafted with goat’s milk, coconut oil, probiotics and other clean, natural ingredients that deeply hydrate and support your skin barrier. </p>"
          }
        },
        "faq_grid_fTBbW6": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Is this soap suitable for sensitive skin?",
            "faq_title_desc": "<p>Yes, the formulation uses gentle, natural ingredients and is free from synthetic fragrances and harsh chemicals, making it a great choice for sensitive or reactive skin.</p>"
          }
        },
        "faq_grid_rf4KXb": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Can I use it on my face and body?",
            "faq_title_desc": "<p>Absolutely. This soap is designed for multi-purpose use: hands, face and full body. </p>"
          }
        },
        "faq_grid_pfyBpz": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Where is it made?",
            "faq_title_desc": "<p>The Body Restore Goat Milk Soap is proudly made in the USA. It is formulated with clean, natural ingredients and free from harsh fillers, making it a safe option for everyday use.</p>"
          }
        },
        "faq_grid_RRD83g": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "How long does shipping take?",
            "faq_title_desc": "<p>Orders are processed quickly and typically arrive within 3 to 5 business days. You’ll receive a tracking number once your order ships so you can follow it right to your door.</p>"
          }
        },
        "faq_grid_AhkemP": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What is your return policy if I’m not satisfied?",
            "faq_title_desc": "<p>We offer a 30-day money-back guarantee if you’re not fully satisfied. </p>"
          }
        }
      },
