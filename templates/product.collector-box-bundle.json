    "n_faq_M7hUjR": {
      "type": "n_faq",
      "blocks": {
        "faq_grid_yDNGke": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What makes Body Restore different?",
            "faq_title_desc": "<p>Body Restore Shower Steamers are proudly made in the <strong>USA</strong> with <strong>natural essential oils</strong> 🍃 and clean ingredients, ensuring a <strong>pure</strong> and <strong>safe</strong> aromatherapy experience. Each steamer comes in high-quality packaging, delivering a strong and refreshing natural scent that enhances your self-care routine.</p>"
          }
        },
        "faq_grid_CH8WaX": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What are the best practices in using these shower tablets?",
            "faq_title_desc": "<p>We recommend to use one tablet per shower or two tablets to double the strength if needed. Use it in hot showers and make sure it’s not submerged in water, but rather placed under the shower stream of hot water.</p>"
          }
        },
        "faq_grid_hwBK86": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Will these tablets make the floor slippery and create stains or drain clogs?",
            "faq_title_desc": "<p>These shower tablets will not make the floor slippery and unlike other branded shower tablets with petals, it will dissolve smoothly to create a no-mess, no-drain-clog experience.</p>"
          }
        },
        "faq_grid_zeU97E": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Can these shower tablets be used as bath bombs?",
            "faq_title_desc": "<p>We do not recommend these used as bath bombs. These tablets work best when not submerged in water, making it perfect for the shower experience. However, you can place the shower tablet on the side of the bath tub and it will activate the aromatherapy with a sprinkle of water contact.</p>"
          }
        },
        "faq_grid_aMxt4j": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Do these shower tablets have a shelf life?",
            "faq_title_desc": "<p>These shower tablets are individually foil wrapped to ensure maximum shelf life. We recommend using the shower steamers within a year for the best experience.</p>"
          }
        },
        "faq_grid_9YQRgp": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "How long does each shower tablet last?",
            "faq_title_desc": "<p>Each tablet duration can vary for each person as shower water pressure can play a role in the longevity of each tablet. It can range from 5 minutes to 15 minutes.</p>"
          }
        },
        "faq_grid_kwXjAe": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Are the shower steamers safe to use during pregnancy?",
            "faq_title_desc": "<p>Aromatherapy is generally safe for pregnant women. However, please do consult a doctor before use to confirm.</p>"
          }
        },
        "faq_grid_fVKED9": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "How long does shipping take?",
            "faq_title_desc": "<p>Shipping generally takes 3-5 business days.</p>"
          }
        },
        "faq_grid_b9UgQU": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What is the return policy?",
            "faq_title_desc": "<p>We strive our best to ensure the best customer experience. We're so confident you'll love our products that we offer a 30-day 100% money back guarantee!</p>"
          }
        }
      },
