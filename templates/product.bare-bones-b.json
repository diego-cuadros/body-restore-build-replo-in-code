    "n_faq_M7hUjR": {
      "type": "n_faq",
      "blocks": {
        "faq_grid_yDNGke": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What makes Body Restore different?",
            "faq_title_desc": "<p>Body Restore Steam Eye Masks are made with natural essential oils 🍃 and clean ingredients, ensuring a pure and safe aromatherapy experience. Each mask is made with high quality materials, delivering a strong and refreshing natural scent that enhances your self-care routine.</p>"
          }
        },
        "faq_grid_CH8WaX": {
          "type": "faq_grid",
          "disabled": true,
          "settings": {
            "faq_title_sub": "What are the best practices in using these steam eye masks?",
            "faq_title_desc": "<p>Body Restore Steam Eye Masks are made with natural essential oils 🍃 and clean ingredients, ensuring a pure and safe aromatherapy experience. Each mask is made with high quality materials, delivering a strong and refreshing natural scent that enhances your self-care routine.</p>"
          }
        },
        "faq_grid_3DmQEY": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "When is the best time to use a steam eye mask?",
            "faq_title_desc": "<p>These masks can be used anytime you need relaxation — whether before bed, during travel, after screen time, or while meditating. Many people use them nightly to help unwind and fall asleep faster.</p>"
          }
        },
        "faq_grid_9GiRCz": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Do I need a microwave or battery to heat the mask?",
            "faq_title_desc": "<p>No — the mask is completely self-heating. Once opened, it naturally warms up on its own using gentle steam technology, so you can enjoy soothing relief anywhere without extra equipment.</p>"
          }
        },
        "faq_grid_CHjBzd": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Do these steam eye masks have a shelf life?",
            "faq_title_desc": "<p>Our steam eye masks are individually foil wrapped to ensure maximum shelf life. We recommend using the steam masks within a year for the best experience.</p>"
          }
        },
        "faq_grid_cYE6rt": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "How long does each steam eye mask last?",
            "faq_title_desc": "<p>Each steam eye mask can last up to 30 minutes of soothing warmth to relax, relieve eye strain, and melt away stress.</p>"
          }
        },
        "faq_grid_UGQ46n": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Are they safe to use during the pregnancy?",
            "faq_title_desc": "<p>Aromatherapy is generally safe for pregnant women. However, please do consult a doctor before use to confirm.</p>"
          }
        },
        "faq_grid_rTPU7t": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "How long does shipping take?",
            "faq_title_desc": "<p>Shipping generally takes 3-5 business days.</p>"
          }
        },
        "faq_grid_MAFcKb": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What is the return policy?",
            "faq_title_desc": "<p>We strive our best to ensure the best customer experience. We're so confident you'll love our products that we offer a 30 day 100% money back guarantee!</p>"
          }
        }
      },
