    "n_faq_M7hUjR": {
      "type": "n_faq",
      "blocks": {
        "faq_grid_yDNGke": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What makes Body Restore different?",
            "faq_title_desc": "<p>Body Restore is proudly made in the USA using premium, grass-fed beef tallow and pure, natural ingredients. We never use fillers, synthetics, or harsh additives. Each product is crafted with nutrient-rich, clean formulas that deliver real results while reflecting our commitment to quality, transparency, and uncompromising skin care.</p>"
          }
        },
        "faq_grid_CH8WaX": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Can I use it on my face as well as my body?",
            "faq_title_desc": "<p>Yes — the formula is marketed for head-to-toe use: face, hands, body. A little goes a long way. Because the texture is richer than typical lotions, you may want to use a smaller amount on the face until you gauge how your skin responds.</p>"
          }
        },
        "faq_grid_hwBK86": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What are the key ingredients?",
            "faq_title_desc": "<ul><li>Grass-fed beef tallow: rich in fat-soluble vitamins (A, D, E, K) and fatty acids, chosen for barrier-support and deep occlusion.</li><li>Manuka honey: a natural humectant and soothing agent, supporting skin repair and calming irritation.</li><li>Jojoba oil: a skin-friendly oil that mimics skin’s natural sebum, helping absorption and skin compatibility.</li><li>Colloidal oatmeal: a classic soothing agent for sensitive or irritated skin.</li></ul>"
          }
        },
        "faq_grid_zeU97E": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Does it have a scent or fragrance?",
            "faq_title_desc": "<p>Some variants may include light natural aroma (depending on essential-oil additions or scent options such as grapefruit, lavender). For those with fragrance sensitivity, look for the unscented or “light scent” version if available. The base product uses clean ingredients with no synthetic fragrance fillers. </p>"
          }
        },
        "faq_grid_aMxt4j": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What’s the shelf life and how should I store it?",
            "faq_title_desc": "<p>Store in a cool, dry place away from direct heat or sunlight (since fats can melt or degrade). Use within a reasonable timeframe (e.g., 12 months after opening) for optimal freshness.</p>"
          }
        },
        "faq_grid_9YQRgp": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Where is it made and is it safe?",
            "faq_title_desc": "<p>The Whipped Beef Tallow product is made in the USA. We always emphasize clean, minimal ingredients and grass-fed sourcing of the tallow. As with any skincare product, if you have a known allergy (e.g., to bees/honey, oats, etc.), check the full ingredients list thoroughly.</p>"
          }
        },
        "faq_grid_kwXjAe": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "How long does shipping take?",
            "faq_title_desc": "<p>Orders are processed quickly and typically arrive within 3 to 5 business days. You’ll receive a tracking number once your order ships so you can follow it right to your door.</p>"
          }
        },
        "faq_grid_fVKED9": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What is your return policy if I’m not satisfied?",
            "faq_title_desc": "<p>We offer a 30-day money-back guarantee if you’re not fully satisfied. </p>"
          }
        }
      },
