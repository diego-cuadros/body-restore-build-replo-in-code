    "f02c4a1f-2226-4b3d-9b81-4e727bcddb6f": {
      "type": "is--faq",
      "blocks": {
        "8e9c1144-9eba-4f1f-abc5-eec895351353": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What makes Body Restore different?",
            "faq_title_desc": "<p>Body Restore Shower Steamers are proudly made in the <strong>USA</strong> with <strong>natural essential oils</strong> 🍃 and clean ingredients, ensuring a <strong>pure</strong> and <strong>safe</strong> aromatherapy experience. Each steamer comes in high-quality packaging, delivering a strong and refreshing natural scent that enhances your self-care routine.</p>"
          }
        },
        "1b15e7eb-124b-4c66-be91-b98c214f8177": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "What are the best practices in using these shower tablets?",
            "faq_title_desc": "<p>We recommend to use one tablet per shower or two tablets to double the strength if needed. Use in hot shower and make sure it’s not submerged in water but rather placed under the shower stream of hot water.</p>"
          }
        },
        "bd476701-0ded-470a-b248-abfe9cbe6027": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Will these tablet make floor slippery, create stains and drain clogs?",
            "faq_title_desc": "<p>These shower tablets will not make the floor slippery and unlike other brands with petals, it will dissolve smoothly to create a no mess no drain clog experience.</p>"
          }
        },
        "afd95972-952f-4b3f-a3d3-c65c0d00bb9a": {
          "type": "faq_grid",
          "settings": {
            "faq_title_sub": "Can these shower tablets be used as a bath bombs?",
            "faq_title_desc": "<p>We do not recommend these used as bath bombs. These tablets work best when not submerged in water, making it perfect for the shower experience. However, you can place the shower tablet on the side of the bath tub and it will activate the aromatherapy with a sprinkle of water contact.</p>"
          }
        },
        "0be56bbe-5f86-4e90-884d-c45fce628822": {
          "type": "faq_grid",
          "settings": {
