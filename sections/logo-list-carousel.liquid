{% style %}
  #shopify--{{ section.id }} .logo-list-title{line-height:1;}
  #shopify--{{ section.id }} .logo-list-container{display:flex;flex-direction:column;gap:0px;}
  #shopify--{{ section.id }} .logo-wrapper{display:flex;position:relative;height:{{ section.settings.height }}px;}
  #shopify--{{ section.id }} .logo-wrapper > *{height:100%;max-width:-webkit-fit-content;opacity:.6;object-fit:contain;}
  #shopify--{{ section.id }} .logo-list-slider{width:100%;}
  #shopify--{{ section.id }} .logo-list-slider .swiper-wrapper{-webkit-transition-timing-function:linear!important;transition-timing-function:linear!important;}
  #shopify--{{ section.id }} .logo-list-slider .swiper-slide{width:fit-content;}
  #shopify--{{ section.id }} .section-border{border-top: 1px solid;border-bottom: 1px solid; border-color: {{section.settings.border_color}};}




   @media screen and (max-width:768px){
    #shopify--{{ section.id }}  .logo-list-container{grid-template-columns:1fr;gap:0px;}
  #shopify--{{ section.id }} .logo-wrapper{ height:{{ section.settings.height_mob }}px;}
   }
{% endstyle %}
<custom-logo-slider
  id="shopify--{{ section.id }}"
  data-speed="{{ section.settings.carousel_speed | append: "000" }}"
  data-sectionid="{{ section.id }}"
  style="opacity:0;"
>
  <div
    class="logo-list-wrapper {% if section.settings.border == true %} section-border {% endif %} padding-top-{{ section.settings.padding_top }} padding-bottom-{{ section.settings.padding_bottom }} padding-top-mob-{{ section.settings.mobile_padding_top }} padding-bottom-mob-{{ section.settings.mobile_padding_bottom }} margin-top-{{ section.settings.margin_top }} margin-bottom-{{ section.settings.margin_bottom }} margin-top-mob-{{ section.settings.mobile_margin_top }} margin-bottom-mob-{{ section.settings.mobile_margin_bottom }}"
    style="background:{{ section.settings.background }};"
  >
    <div class="page-width">
      <div class="logo-list-container">
        <div class="logo-list-info">
          {% for block in section.blocks %}
            {% case block.type %}
              {% when 'title' %}
                <div
                  class="logo-list-title text-align-{{ section.settings.alignment }} font-size-{{ block.settings.font_size }} font-weight-{{ block.settings.font_weight }} font-size-mob-{{ block.settings.mobile_font_size }} font-weight-mob-{{ block.settings.mobile_font_weight }} padding-bottom-{{ block.settings.padding_bottom }} padding-bottom-mob-{{ block.settings.mobile_padding_bottom }}"
                  style="color:{{ block.settings.color }};max-width:{{ block.settings.width }}px;"
                >
                  {{ block.settings.title }}
                </div>
              {% when 'content' %}
                <div
                  class="logo-list-content text-align-{{ section.settings.alignment }} font-size-{{ block.settings.font_size }} font-weight-{{ block.settings.font_weight }} font-size-mob-{{ block.settings.mobile_font_size }} font-weight-mob-{{ block.settings.mobile_font_weight }} padding-bottom-{{ block.settings.padding_bottom }} padding-bottom-mob-{{ block.settings.mobile_padding_bottom }}"
                  style="color:{{ block.settings.color }};max-width:{{ block.settings.width }}px;"
                >
                  {{ block.settings.content }}
                </div>
            {% endcase %}
          {% endfor %}
        </div>
        <div class="logo-list-slider  logo-list-slider--{{ section.id }} swiper">
          <div class="swiper-wrapper">
            {% for i in (1..3) %}
              {% for block in section.blocks %}
                {% if block.type == 'logo' %}
                  <div class="swiper-slide">
                    <div class="logo-wrapper">
                      {% if block.settings.logo != blank %}
                        <img src="{{ block.settings.logo | img_url:'master' }}">
                      {% else %}
                        {{ 'lifestyle-1' | placeholder_svg_tag }}
                      {% endif %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </div>
</custom-logo-slider>
