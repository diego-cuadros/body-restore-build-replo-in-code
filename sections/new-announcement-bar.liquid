<div id="section-{{ section.id }}" class="announce_bar_new" >
{% comment %}

  {% if template.suffix == 'landing-page' %}
    <section class="announcement-new">
      <div class="marquee-wrapper">
        <div class="container">
          <div class="marquee-block">
            <div class="marquee-inner to-left">
              <span>
                {% for block in section.blocks %}
                  <div class="marquee-item h5">
                    <p class="announcement_text {% if block.settings.url == blank %} button-landing-banner {% endif %}">
                      {% if block.settings.url != blank %}
                        <a href="{{ block.settings.url }}">
                      {% endif %}
                      {{ block.settings.announcement }}
                      {% if block.settings.url != blank %}
                        </a>
                      {% endif %}
                    </p>
                  </div>
                {% endfor %}
              </span>
