<style>
  .richtext--{{ section.id }} .page-width{max-width:{{section.settings.width}}px;width:100%;}
  .richtext--{{ section.id }} .page-width p {margin:0px;}
  .richtext--{{ section.id }} .page-width .line {display:block;height:2px;}
  .richtext--{{ section.id }} .container{display:flex;flex-direction:column;align-items:{{section.settings.align}};justify-content:{{section.settings.align}};text-align:{{section.settings.align}};padding:0px;}
  .richtext--{{ section.id }} .grid-container {display:grid;grid-template-columns:repeat({{section.settings.grid-count}} , 1fr);gap:40px;width:100%;}
  .richtext--{{ section.id }} .grid-container .grid-item {max-width:{{section.settings.grid-width}}px;width:100%;display:flex;flex-direction:row;position:relative; padding: 0px;margin: 0px auto;} 
  .richtext--{{ section.id }} .grid-container .grid-item .inner-container{width:100%;display:flex;flex-direction:column;gap:0px;align-items:center;text-align:center;}
  .richtext--{{ section.id }} .grid-container .grid-item .inner-container .image {height:{{ section.settings.imageheight }}px;margin-bottom:10px;padding:5px;}
  .richtext--{{ section.id }} .grid-container .grid-item .inner-container .image img{width:100%;height:100%;object-fit:contain;}
  .richtext--{{ section.id }} .heading * {font-size:inherit;color:inherit;font-weight:inherit;margin:0px;}
  .richtext--{{ section.id }} .content * {font-size:inherit;color:inherit;font-weight:inherit;margin:0px;}
  .richtext--{{ section.id }} .grid-container .grid-item .title {margin-top:0px;letter-spacing}
  .richtext--{{ section.id }} .grid-container .grid-item .title p {margin-top:8px;}
  .richtext--{{ section.id }} .grid-container .grid-item .title p:first-child {margin-top:0px;}

  @media screen and (max-width:768px) {
  .richtext--{{ section.id }} .container{display:flex;flex-direction:column;align-items:{{section.settings.alignmob}};justify-content:{{section.settings.alignmob}};text-align:{{section.settings.alignmob}};}
  .richtext--{{ section.id }} .grid-container {display:grid;grid-template-columns:repeat(2 , 1fr);gap:16px;}
  .richtext--{{ section.id }} .grid-container .grid-item { flex-direction:column;position:relative; padding: 16px 0px 0px; }
  .richtext--{{ section.id }} .grid-container .grid-item:first-child,
  .richtext--{{ section.id }} .grid-container .grid-item:nth-child(2) {  padding:0px 0px; } 

  }
</style>

<section
  class="richtext--{{ section.id }} padding-top-{{ section.settings.padding_top }} padding-bottom-{{ section.settings.padding_bottom }} padding-top-mob-{{ section.settings.mobile_padding_top }} padding-bottom-mob-{{ section.settings.mobile_padding_bottom }}"
  style="background:{{ section.settings.bg-color }};"
>
  <div class="page-width">
    <div class="container">
      {% for block in section.blocks %}
        {% case block.type %}
          {% when 'heading' %}
            <div
              class="h2 heading margin-bottom-{{ block.settings.space }} margin-bottom-mob-{{ block.settings.space_mob }} font-size-mob-{{ block.settings.mobile_size }} font-size-{{ block.settings.size }} font-weight-{{ block.settings.weight }}"
              style="color:{{ block.settings.color }};max-width:{{ block.settings.width }}px;width:100%;"
            >
              {{ block.settings.heading }}
            </div>
          {% when 'content' %}
            <div
              class="content margin-bottom-{{ block.settings.space }} margin-bottom-mob-{{ block.settings.space_mob }} font-size-mob-{{ block.settings.mobile_size }} font-size-{{ block.settings.size }} font-weight-{{ block.settings.weight }}"
              style="color:{{ block.settings.color }};max-width:{{ block.settings.width }}px;width:100%;"
            >
              {{ block.settings.content }}
            </div>
          {% when 'line' %}
            <div
              class="line margin-bottom-{{ block.settings.space }} margin-bottom-mob-{{ block.settings.space_mob }}"
              style="background-color:{{ block.settings.color }};max-width:{{ block.settings.width }}px;width:100%;"
            ></div>
          {% when 'button' %}
            {% if block.settings.button != blank %}
              <div class="banner_inner_detail margin-bottom-{{ block.settings.space }} margin-bottom-mob-{{ block.settings.space_mob }}">
                <a
                  href="{{ block.settings.button_link }}"
                  class="brightangel-button btn brightangel-{{ block.settings.button_type }}-button  font-size-mob-{{ block.settings.mobile_size }} font-size-{{ block.settings.size }} font-weight-{{ block.settings.weight }}"
                  style="color:{{ block.settings.color }};"
                >
                  {{ block.settings.button }}
                </a>
              </div>
            {% endif %}
        {% endcase %}
      {% endfor %}
      <div class="grid-container">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'grid' %}
              <div class="grid-item">
                <div class="inner-container">
                  {% if block.settings.image != blank %}
                    <div class="image">
                      <img src="{{ block.settings.image | img_url : 'master' }}">
                    </div>
                  {% endif %}
                  {% if block.settings.title != blank %}
                    <div
                      class="title margin-bottom-{{ section.settings.space }} margin-bottom-mob-{{ section.settings.space_mob }} font-size-mob-{{ section.settings.mobile_size }} font-size-{{ section.settings.size }} font-weight-{{ section.settings.weight }}"
                      style="color:{{ section.settings.color }};"
                    >
                      {{ block.settings.title }}
                    </div>
                  {% endif %}
                  {% if block.settings.text != blank %}
                    <div
                      class="text margin-bottom-{{ section.settings.tspace }} margin-bottom-mob-{{ section.settings.tspace_mob }} font-size-mob-{{ section.settings.tmobile_size }} font-size-{{ section.settings.tsize }} font-weight-{{ section.settings.tweight }}"
                      style="color:{{ section.settings.tcolor }};"
                    >
                      {{ block.settings.text }}
                    </div>
                  {% endif %}
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

