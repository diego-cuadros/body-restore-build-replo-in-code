{{ "what-different.css" | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding.page-width {
    max-width: 118.4rem;
  }
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% assign show_section = false %}
{% if product.metafields.custom.other_image != blank and product.metafields.custom.body_restore_image != blank %}
  {% assign show_section = true %}
{% elsif template.suffix == 'replo-collectors-box' %}
  {% assign show_section = true %}
{% endif %}



{% if show_section %}
 
<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width{% if section.settings.heading == blank %} no-heading{% endif %} section-{{ section.id }}-padding">
    <div class="what-different__title title-wrapper title-wrapper--no-top-margin text-center">
      {%- if section.settings.heading != blank -%}
        <h2 class="what-different-wrapper-title inline-richtext {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="what-different__description  rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ section.settings.description -}}
        </div>
      {%- endif -%}
    </div>
    
    <div class="different-tabs-buttons" style="--tab-background-color: {{ section.settings.tab_background }};--tab-text-color: {{ section.settings.tab_text_color }};">
      {% for block in section.blocks %}
        <div class="tab-button {% if forloop.last %}active{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %} data-tab-key="{{ block.settings.title | handle }}--{{ block.id }}">
          {{- block.settings.title -}}
        </div>
      {% endfor %}
    </div>
    <div class="different-tabs-content">
      {% for block in section.blocks %}
        <div id="{{ block.settings.title | handle }}--{{ block.id }}" class="tab-item {% if forloop.last %}active{% endif %} {% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" {% if settings.animations_reveal_on_scroll %}data-cascade style="--animation-order: {{ forloop.index }};"{% endif %} {{ block.shopify_attributes }}>
          <div class="tab-wrapper">
            {%- if block.settings.image != blank -%}
              <div class="tab-media media gradient color-{{ section.settings.color_scheme }} global-media-settings" style="padding-bottom: {{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;">
                {{ block.settings.image | image_url: width: 3840 | image_tag:
                  loading: 'lazy',
                  sizes: '100vw',
                  widths: '375, 750, 1100, 1500, 1780, 2000, 3000, 3840',
                  alt: block.settings.image.alt
              }}
              </div>
            {%- else -%}
              <div class="tab-media placeholder gradient color-{{ section.settings.color_scheme }}">
                {{ 'detailed-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
              </div>
            {%- endif -%}
          </div>
        </div>
      {% endfor %}
    </div>
  </div>
</div>
{%- endif -%}
{% schema %}
  {
    "name": "What different",
    "tag": "section",
    "class": "section what-different",
    "disabled_on": {
      "groups": ["header", "footer"]
    },
    "settings": [
      {
        "type": "inline_richtext",
        "id": "heading",
        "default": "What different?",
        "label": "Heading"
      },
      {
        "type": "select",
        "id": "heading_size",
        "options": [
          {
            "value": "h2",
            "label": "t:sections.all.heading_size.options__1.label"
          },
          {
            "value": "h1",
            "label": "t:sections.all.heading_size.options__2.label"
          },
          {
            "value": "h0",
            "label": "t:sections.all.heading_size.options__3.label"
          }
        ],
        "default": "h1",
        "label": "t:sections.all.heading_size.label"
      },
      {
        "type": "richtext",
        "id": "description",
        "label": "Description"
      },
      {
        "type": "color_scheme",
        "id": "color_scheme",
        "label": "t:sections.all.colors.label",
        "info": "t:sections.all.colors.has_cards_info",
        "default": "background-1"
      },
      {
        "type": "header",
        "content": "Tab Colors"
      },
      {
        "type": "color",
        "id": "tab_background",
        "label": "Tab Background Color",
        "default": "#B9DCE1"
      },
      {
        "type": "color",
        "id": "tab_text_color",
        "label": "Tab text Color",
        "default": "#0C2331"
      },
      {
        "type": "header",
        "content": "t:sections.all.padding.section_padding_heading"
      },
      {
        "type": "range",
        "id": "padding_top",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_top",
        "default": 36
      },
      {
        "type": "range",
        "id": "padding_bottom",
        "min": 0,
        "max": 100,
        "step": 4,
        "unit": "px",
        "label": "t:sections.all.padding.padding_bottom",
        "default": 36
      }
    ],
    "blocks": [
      {
        "type": "different-tab",
        "name": "Different tab",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "default": "Different tab title",
            "label": "Heading"
          },
          {
            "type": "header",
            "content": "Tab Content"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
          }
        ]
      }
    ],
    "max_blocks": 2,
    "presets": [
      {
        "name": "What different",
        "blocks": [
          {
            "type": "different-tab"
          },
          {
            "type": "different-tab"
          }
        ]
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}