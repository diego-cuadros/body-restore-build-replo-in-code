    }
    .info_list_main ul li {
        gap: 20px;
    }
    .info_list_main_wrapper {
        padding-bottom: 40px;
    }
  }


  /* -------cta_bottom_sec-------- */
      .cta_bottom_sec{
        margin-top:75px;
        padding:100px 0px;
        background-color:#0C2331;
      }
      .cta_container{
        max-width:1280px;
        margin:0px auto;
        padding:0px 20px;
      }
      .cta_container .row{
        display: flex;
        align-items: center;
      }
      .cta_wrapper {
        max-width: 850px;
        margin: 0px auto;
        text-align: center;
        color: #FFF;
        display: flex;
        flex-direction: column;
        gap: 30px;
        align-items: center;
    }
    .cta_wrapper h2 {
      font-family: 'Montserrat';
        font-size: 48px;
