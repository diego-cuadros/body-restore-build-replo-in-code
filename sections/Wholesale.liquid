    }
  .cta_wrapper a:hover {
      background:transparent;
      color:#FFF;
      border:1px solid #fff;
  }

  .cta_wrapper a:hover svg{
    fill:#FFFFFF;
  }
  @media(max-width:767px){
    .cta_bottom_sec {
        margin-top: 50px;
    }
    .cta_bottom_sec {
