        margin: 0;
        color: #FFF;
    }
    .cta_wrapper p {
        font-size:20px;
      line-height: 30px;
        margin: 0;
    }

    .cta_wrapper a {
      background: #FFF;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      padding: 17px 40px;
      border-radius: 10px;
      text-decoration: none;
      color: #0C2331;
      font-size: 16px;
      font-weight: 700;
      line-height: 16px;
      letter-spacing: 0;
      border:1px solid #FFFFFF;
