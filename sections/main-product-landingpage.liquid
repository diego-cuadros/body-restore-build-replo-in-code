<style>
  .btn-container .quantity-container {
	display: none;
}
  .var-container .products-grid {
	display: flex;
	flex-wrap: wrap;
}
.var-container .featured-gift-container {
	width: 20%;
}
  .mbr_price_totalwrap .mbr_pricetotal10 {
	display: none;
}
.mbr_price_totalwrap .mbr_pricetotal25 {
	display: none;
}
.mbr_price_totalwrap .mbr_pricetotal33 {
	display: none;
}
.mbr_price_totalwrap .mbr_pricetotal40 {
	display: none;
}
  .mbr_price_totalwrap.dis10 .mbr_pricetotal0, 
  .mbr_price_totalwrap.dis25 .mbr_pricetotal0, 
  .mbr_price_totalwrap.dis33 .mbr_pricetotal0, 
  .mbr_price_totalwrap.dis40 .mbr_pricetotal0 {
	display: none;
}
 .mbr_price_totalwrap.dis10 .mbr_pricetotal10 {
	display: block;
}
 .mbr_price_totalwrap.dis25 .mbr_pricetotal25 {
	display: block;
}
 .mbr_price_totalwrap.dis33 .mbr_pricetotal33 {
	display: block;
}
 .mbr_price_totalwrap.dis40 .mbr_pricetotal40 {
	display: block;
}
.mbr_pricetotal0 .firstshow {
	display: none;
}
.mbr_pricetotal0 .firstshow:first-child {
	display:block;
}
.save-container span {
	display: none;
}
.save-container span:first-child {
	display: inline-block;
}
.mbr_price_totalwrap.dis10 .totaldiscount0, 
  .mbr_price_totalwrap.dis25 .totaldiscount0, 
  .mbr_price_totalwrap.dis33 .totaldiscount0, 
  .mbr_price_totalwrap.dis40 .totaldiscount0 {
	display: none;
}
 .mbr_price_totalwrap.dis10 .totaldiscount10 {
	display: inline-block;
}
 .mbr_price_totalwrap.dis25 .totaldiscount25 {
	display: inline-block;
}
 .mbr_price_totalwrap.dis33 .totaldiscount33 {
	display: inline-block;
}
 .mbr_price_totalwrap.dis40 .totaldiscount40 {
	display: inline-block;
}
  .template-product-bundle-landing .header-wrapper {
	display: none;
}
.template-product-bundle-landing .breadcrumbs {
	display: none;
}
.template-product-bundle-landing .announcement-bar-container {
	display: none;
}
  #shopify-section-{{section.id}} #product-form-selling-plan ul {border:0px;border-radius:0px;}
  #shopify-section-{{section.id}} .save-and-sub-container { width:100%; }
  #shopify-section-{{section.id}} .save-and-sub-container .subscribe-header { background-color: #4B3F8A; color: #fff; padding: 5px 30px; font-size: 12px; font-weight:600; text-align: center; border-radius: 5px 5px 0 0; margin-bottom: 0px;width:fit-content; margin:auto;}
  #shopify-section-{{section.id}} .save-and-sub-container .form-check-label { display:block; border: 0px solid #F4F4F4;  margin-bottom: 10px; cursor: pointer; transition: border-color 0.3s; }
  #shopify-section-{{section.id}} .save-and-sub-container .purchase-option-title {background:transparent;border-radius: 8px; border: 2px solid #f4f4f4 !important; display: flex; align-items: center; gap: 8px;width:100%;justify-content:space-between;min-width:100%;width:100%;  padding:16px 30px;/*box-shadow: rgba(100, 100, 111, 0.2) 0px 7px 29px 0px;*/}
  #shopify-section-{{section.id}} .save-and-sub-container .form-check-label .original-price {color: #888888;  font-weight: 400;text-decoration: line-through;}
  #shopify-section-{{section.id}} .save-and-sub-container .form-check-label .discount-price {color: #0c2331;  font-weight: 800; }
  #shopify-section-{{section.id}} .save-and-sub-container .form-check-label span {font-size:18px; }
  #shopify-section-{{section.id}} .save-and-sub-container .form-check-label h3 {margin-bottom:0px;}
  #shopify-section-{{section.id}} .save-and-sub-container .form-check-label .form-check-input:checked ~ .purchase-option-title {border-color: #4B3F8A !important;box-shadow:0 2px 2px #4B3F8A40;}
  #shopify-section-{{section.id}} .save-and-sub-container .selling-plan-item label {background-color:transparent;border:2px solid #e1e1e1;font-size:20px;cursor:pointer;}
  #shopify-section-{{section.id}} .save-and-sub-container .selling-plan-item label span{font-size:14px;}
  #shopify-section-{{section.id}} .save-and-sub-container .selling-plan-item input[type=radio]:checked+label {border-color: #4B3F8A !important; }
  #shopify-section-{{section.id}} .save-and-sub-container .selling-plan-wrapper {padding:0.8rem 0px 2.4rem;padding-top:20px;padding-bottom:20px;column-gap:14px;}
  #shopify-section-{{section.id}} .save-and-sub-container #product-form-delivery-option p{padding-bottom:20px;font-size:14px;text-align:center;padding-left:10px;padding-right:10px;}
  #shopify-section-{{section.id}} .save-and-sub-container #product-form-delivery-option{background-color:transparent !important;}
  #shopify-section-{{section.id}} .save-and-sub-container .selling-plan-item{min-width:calc(100% / 3 - 10px);max-width:calc(100% / 3 - 10px);width:100%;}


  @media screen and (max-width:1024px){
    #shopify-section-{{section.id}} .save-and-sub-container .purchase-option-title{padding:16px 14px;}
  }

  @media screen and (max-width:768px){
    #shopify-section-{{section.id}} .save-and-sub-container .selling-plan-item label{font-size:18px;}
    #shopify-section-{{section.id}} .save-and-sub-container .purchase-option-title{padding:16px 14px;}
    #shopify-section-{{section.id}} .purchase-option-title h3{font-size:15px;}
    #shopify-section-{{section.id}} .save-and-sub-container .form-check-label span,
    #shopify-section-{{section.id}} .purchase-option-title label.Subscribe_price{font-size:15px; }
    #shopify-section-{{section.id}} .badge-text {width:100%;margin:20px 0px;padding:0px 0px;}
    #shopify-section-{{section.id}} .product__accordion .inner-container {width:100%;display:flex;flex-direction:column;gap:25px;}
  }
</style>

<section
  id="MainProduct-{{ section.id }}"
  class="mbr_prdpg page-width section-{{ section.id }}-padding"
  data-section="{{ section.id }}"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'component-loading-overlay.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }


    {% assign product_color = product.metafields.custom.product_card_color.value %}
    {% if product_color != blank %}
      #shopify-section-{{ section.id }} {
        --color-background-scent: {{ product_color.background }};
        --color-background-card: {{ product_color.background_card }};
        --color-background-media: {{ product_color.background_media }};
        --color-foreground-scent: {{ product_color.text }};
      }
      .form-check-label input[type=radio]::after {border-color: rgb(var(--color-foreground-scent));}
      .form-check-label input[type=radio]:checked::before {background: rgb(var(--color-foreground-scent));}
    {% endif %}
  {%- endstyle -%}

  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}

  <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
    <div class="grid__item product__media-wrapper{% if section.settings.media_position == 'right' %} medium-hide large-up-hide{% endif %}">
      <div class="mbr_glywrap">
      <div class="mbr_glyblock">
        <div class="mbr_glyblockinn">
          <img src="{{ section.settings.glic1 | img_url: '500x' }}" alt="" width="auto" height="auto" >
          <p>{{ section.settings.gltxt1 }}</p>
        </div>
        <div class="mbr_glyblockinn">
          <img src="{{ section.settings.glic2 | img_url: '500x' }}" alt="" width="auto" height="auto" >
          <p>{{ section.settings.gltxt2 }}</p>
        </div>
        <div class="mbr_glyblockinn">
          <img src="{{ section.settings.glic3 | img_url: '500x' }}" alt="" width="auto" height="auto" >
          <p>{{ section.settings.gltxt3 }}</p>
        </div>
      </div>
      {%- comment -%}
      {% render 'product-media-gallery-bundle', variant_images: variant_images %}
      {%- endcomment -%}
      <div class="mbr_bundleslider">
      <div class="swiper mySwiper2">
        <div class="swiper-wrapper">
          {%- for media in product.media -%}
          <div class="swiper-slide">
            <img src="{{ media | img_url: '1000x'}}" alt="" width="auto" height="auto"/>
          </div>
          {%- endfor -%}
        </div>

         <div class="swiper-button-next swiper-buttons">{% render 'arrow-left' %}</div>
            <div class="swiper-button-prev swiper-buttons">{% render 'arrow-right' %}</div>
      </div>
      <div thumbsSlider="" class="swiper mySwiper">
        <div class="swiper-wrapper">
          {%- for media in product.media -%}
          <div class="swiper-slide">
            <img src="{{ media | img_url: '1000x'}}" alt="" width="auto" height="auto"/>
          </div>
          {%- endfor -%}
        </div>
      </div>
      </div>
    </div>
    </div>
    {% comment %}
      <div class="product_popup_mian">
        {% render 'product-popup' %}
      </div>
    {% endcomment %}

    <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <product-info
        id="ProductInfo-{{ section.id }}"
        data-section="{{ section.id }}"
        data-url="{{ product.url }}"
        class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
      >
        {%- assign product_form_id = 'product-form-' | append: section.id -%}

        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'text' -%}
              <p
                class="product__text inline-richtext{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}"
                {{ block.shopify_attributes }}
              >
                {{- block.settings.text -}}
              </p>
            {%- when 'title' -%}
              <div class="product__title" {{ block.shopify_attributes }}>
                <h1>{{ product.title | escape }}</h1>
<!-- Start Areviews product title Rating Code -->
<div class='areviews_header_stars'></div>
<!-- End Areviews product title Rating Code -->


                <a href="{{ product.url }}" class="product__title">
                  <h2 class="h1">
                    {{ product.title | escape }}
                  </h2>
                </a>
              </div>
            {%- when 'line' -%}
              <hr {{ block.shopify_attributes }}>
            {%- when 'price' -%}
              <div
                class="no-js-hidden product_price"
                id="price-{{ section.id }}"
                role="status"
                {{ block.shopify_attributes }}
              >
                {%- render 'price',
                  product: product,
                  use_variant: true,
                  show_badges: true,
                  price_class: 'price--large'
                -%}
              </div>
              {%- if product.quantity_price_breaks_configured? -%}
                <div class="volume-pricing-note">
                  <span>{{ 'products.product.volume_pricing.note' | t }}</span>
                </div>
              {%- endif -%}
              <div class="product__tax caption rte">
                {%- if cart.taxes_included -%}
                  {{ 'products.product.include_taxes' | t }}
                {%- endif -%}
                {%- if shop.shipping_policy.body != blank -%}
                  {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              </div>
              <div {{ block.shopify_attributes }}>
                {%- assign product_form_installment_id = 'product-form-installment-' | append: section.id -%}
                {%- form 'product', product, id: product_form_installment_id, class: 'installment caption-large' -%}
                  <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                  {{ form | payment_terms }}
                {%- endform -%}
              </div>
            {%- when 'inventory' -%}
              <p
                class="product__inventory no-js-hidden{% if block.settings.text_style == 'uppercase' %} caption-with-letter-spacing{% elsif block.settings.text_style == 'subtitle' %} subtitle{% endif %}{% if product.selected_or_first_available_variant.inventory_management != 'shopify' %} visibility-hidden{% endif %}"
                {{ block.shopify_attributes }}
                id="Inventory-{{ section.id }}"
                role="status"
              >
                {%- if product.selected_or_first_available_variant.inventory_management == 'shopify' -%}
                  {%- if product.selected_or_first_available_variant.inventory_quantity > 0 -%}
                    {%- if product.selected_or_first_available_variant.inventory_quantity
                        <= block.settings.inventory_threshold
                    -%}
                      <svg width="15" height="15" aria-hidden="true">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(238,148,65, 0.3)"/>
                        <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(238,148,65)"/>
                      </svg>
                      {%- if block.settings.show_inventory_quantity -%}
                        {{-
                          'products.product.inventory_low_stock_show_count'
                          | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                        -}}
                      {%- else -%}
                        {{- 'products.product.inventory_low_stock' | t -}}
                      {%- endif -%}
                    {%- else -%}
                      <svg width="15" height="15" aria-hidden="true">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(62,214,96, 0.3)"/>
                        <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(62,214,96)"/>
                      </svg>
                      {%- if block.settings.show_inventory_quantity -%}
                        {{-
                          'products.product.inventory_in_stock_show_count'
                          | t: quantity: product.selected_or_first_available_variant.inventory_quantity
                        -}}
                      {%- else -%}
                        {{- 'products.product.inventory_in_stock' | t -}}
                      {%- endif -%}
                    {%- endif -%}
                  {%- else -%}
                    {%- if product.selected_or_first_available_variant.inventory_policy == 'continue' -%}
                      <svg width="15" height="15" aria-hidden="true">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(62,214,96, 0.3)"/>
                        <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(62,214,96)"/>
                      </svg>
                      {{- 'products.product.inventory_out_of_stock_continue_selling' | t -}}
                    {%- else -%}
                      <svg width="15" height="15" aria-hidden="true">
                        <circle cx="7.5" cy="7.5" r="7.5" fill="rgb(200,200,200, 0.3)"/>
                        <circle cx="7.5" cy="7.5" r="5" stroke="rgb(255, 255, 255)" stroke-width="1" fill="rgb(200,200,200)"/>
                      </svg>
                      {{- 'products.product.inventory_out_of_stock' | t -}}
                    {%- endif -%}
                  {%- endif -%}
                {%- endif -%}
              </p>
            {%- when 'description' -%}
              <div class="mbr_prdrw">
                <div class="mbr_prdrw_star">
                  <img src="{{section.settings.rvstar | img_url : '1000x' }}" alt="" width="auto" height="auto">
                  {{section.settings.rvstarcnt }}
                </div>
                <div class="mbr_prdrw_cnt">{{section.settings.speciality }}</div>
              </div>
              {%- if product.description != blank -%}
                <div class="product__description rte quick-add-hidden" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}
            {%- when 'reviews-carousel' -%}
              {% if product.metafields.custom.product_testimonials != blank %}
                <div class="reviews-carousel" {{ block.shopify_attributes }}>
                  {% if block.settings.review_title != blank %}
                    <div class="form__label">{{ block.settings.review_title }}</div>
                  {% endif %}
                  <div class="product_testimonials_slider_wrapper">
                    <div class="testimonial_prevnext testimonial_prev">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M0.861675 7.52867L5.52834 2.86201C5.65408 2.74057 5.82248 2.67337 5.99728 2.67489C6.17207 2.67641 6.33928 2.74652 6.46289 2.87013C6.58649 2.99373 6.6566 3.16094 6.65812 3.33574C6.65964 3.51054 6.59245 3.67894 6.47101 3.80467L2.94234 7.33334H14.6663C14.8432 7.33334 15.0127 7.40358 15.1377 7.5286C15.2628 7.65363 15.333 7.8232 15.333 8.00001C15.333 8.17682 15.2628 8.34639 15.1377 8.47141C15.0127 8.59644 14.8432 8.66667 14.6663 8.66667H2.94234L6.47101 12.1953C6.53468 12.2568 6.58547 12.3304 6.62041 12.4117C6.65535 12.4931 6.67374 12.5806 6.67451 12.6691C6.67528 12.7576 6.65841 12.8454 6.62489 12.9273C6.59137 13.0092 6.54187 13.0837 6.47927 13.1463C6.41668 13.2089 6.34224 13.2584 6.26031 13.2919C6.17838 13.3254 6.09059 13.3423 6.00207 13.3415C5.91356 13.3407 5.82607 13.3223 5.74474 13.2874C5.6634 13.2525 5.58984 13.2017 5.52834 13.138L0.861675 8.47134C0.736694 8.34632 0.666485 8.17678 0.666485 8.00001C0.666485 7.82323 0.736694 7.65369 0.861675 7.52867Z" fill="black"></path>
                      </svg>
                    </div>
                    <div class="product_testimonials_slider">
                      {% for product_testimonial in product.metafields.custom.product_testimonials.value %}
                        <div class="product_testimonial_slide">
                          <div class="product_testimonial_header">
                            <h3>{{- product_testimonial.testimonial_title -}}</h3>
                            <span>{{- product_testimonial.testimonial_date | date: '%m/%d/%Y' -}}</span>
                          </div>
                          <div class="product_testimonial_star_wrapper">
                            {%- for i in (1..5) -%}
                              <svg
                                class="icon icon-testimonial-star"
                                width="26"
                                height="24"
                                viewBox="0 0 26 24"
                                fill="none"
                                xmlns="http://www.w3.org/2000/svg"
                              >
                                <path d="M11.9718 0.708465C12.4382 -0.0665188 13.5618 -0.0665184 14.0282 0.708466L17.3461 6.22172C17.5136 6.50013 17.7869 6.6987 18.1035 6.77201L24.3722 8.22386C25.2534 8.42794 25.6006 9.49651 25.0077 10.1796L20.7895 15.0388C20.5765 15.2842 20.4721 15.6054 20.5002 15.9292L21.0566 22.3397C21.1348 23.2408 20.2258 23.9012 19.393 23.5484L13.4681 21.0383C13.1689 20.9116 12.8311 20.9116 12.5319 21.0383L6.60702 23.5484C5.77418 23.9012 4.86521 23.2408 4.94341 22.3397L5.49976 15.9292C5.52786 15.6054 5.42347 15.2842 5.21045 15.0388L0.992333 10.1796C0.399403 9.4965 0.746601 8.42794 1.62778 8.22386L7.89649 6.77201C8.21305 6.6987 8.48635 6.50013 8.6539 6.22172L11.9718 0.708465Z" fill="currentColor"></path>
                              </svg>
                            {%- endfor -%}
                          </div>
                          <div class="product_testimonial_message_wrapper rte">
                            {{- product_testimonial.testimonial_message -}}
                          </div>
                          <div class="product_testimonial_author_wrapper">
                            {{- product_testimonial.testimonial_author -}}
                          </div>
                        </div>
                      {% endfor %}
                    </div>
                    <div class="testimonial_prevnext testimonial_next">
                      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M15.1383 7.52867L10.4717 2.86201C10.3459 2.74057 10.1775 2.67337 10.0027 2.67489C9.82793 2.67641 9.66072 2.74652 9.53711 2.87013C9.41351 2.99373 9.3434 3.16094 9.34188 3.33574C9.34036 3.51054 9.40755 3.67894 9.52899 3.80467L13.0577 7.33334H1.33366C1.15685 7.33334 0.987279 7.40358 0.862254 7.5286C0.73723 7.65363 0.666992 7.8232 0.666992 8.00001C0.666992 8.17682 0.73723 8.34639 0.862254 8.47141C0.987279 8.59644 1.15685 8.66667 1.33366 8.66667H13.0577L9.52899 12.1953C9.46532 12.2568 9.41453 12.3304 9.37959 12.4117C9.34465 12.4931 9.32626 12.5806 9.32549 12.6691C9.32472 12.7576 9.34159 12.8454 9.37511 12.9273C9.40863 13.0092 9.45813 13.0837 9.52073 13.1463C9.58332 13.2089 9.65776 13.2584 9.73969 13.2919C9.82162 13.3254 9.90941 13.3423 9.99793 13.3415C10.0864 13.3407 10.1739 13.3223 10.2553 13.2874C10.3366 13.2525 10.4102 13.2017 10.4717 13.138L15.1383 8.47134C15.2633 8.34632 15.3335 8.17678 15.3335 8.00001C15.3335 7.82323 15.2633 7.65369 15.1383 7.52867Z" fill="black"></path>
