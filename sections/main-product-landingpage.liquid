                  </button>
                </div>
              {% endif %}

              {% assign bundle = product.metafields.custom.bundle_product.value %}
              {{ bundle.title }}
              {% for item in bundle %}
                {{ item.title }}
              {% endfor %}

              {{ product.metafields.custom.bundle_product.value }}
              {% for ingredient in product.metafields.custom.bundle_product.value %}
                {{ ingredient }}
                {{ ingredient.value }}
              {% endfor %}

              {% assign bundle = product.metafields.custom.bundle_product.value %}

              {% for bundle_item in bundle %}
                {% assign bundle_product = all_products[bundle_item] %}

                <div class="bundle-item">
                  <h2>{{ bundle_product.title }}</h2>
                  <img src="{{ bundle_product.featured_image | img_url: 'medium' }}" alt="{{ bundle_product.title }}">
                </div>
              {% endfor %}

              {% for item in bundle.items %}
                {{ item.title }}
                {{ item.price }}
              {% endfor %}
              

            {%- when 'buy_buttons' -%}
              {%- render 'buy-buttons-new-temp',
                block: block,
                product: product,
                product_form_id: product_form_id,
                section_id: section.id,
                show_pickup_availability: true
              -%}

            {%- when 'rating' -%}
              {%- if product.metafields.reviews.rating.value != blank -%}
                <div class="product-rating">
                  {% liquid
                    assign rating_decimal = 0
                    assign decimal = product.metafields.reviews.rating.value.rating | modulo: 1
                    if decimal >= 0.3 and decimal <= 0.7
                      assign rating_decimal = 0.5
                    elsif decimal > 0.7
                      assign rating_decimal = 1
                    endif
                  %}
                  <div
                    class="rating"
                    role="img"
                    aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
                  >
                    <span
                      aria-hidden="true"
                      class="rating-star"
                      style="--rating: {{ product.metafields.reviews.rating.value.rating | floor }}; --rating-max: {{ product.metafields.reviews.rating.value.scale_max }}; --rating-decimal: {{ rating_decimal }};"
                    >
                      {% for i in (1..5) %}
                        <svg
                          class="icon icon-rating-star"
                          width="26"
                          height="24"
                          viewBox="0 0 26 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path d="M11.9718 0.708465C12.4382 -0.0665188 13.5618 -0.0665184 14.0282 0.708466L17.3461 6.22172C17.5136 6.50013 17.7869 6.6987 18.1035 6.77201L24.3722 8.22386C25.2534 8.42794 25.6006 9.49651 25.0077 10.1796L20.7895 15.0388C20.5765 15.2842 20.4721 15.6054 20.5002 15.9292L21.0566 22.3397C21.1348 23.2408 20.2258 23.9012 19.393 23.5484L13.4681 21.0383C13.1689 20.9116 12.8311 20.9116 12.5319 21.0383L6.60702 23.5484C5.77418 23.9012 4.86521 23.2408 4.94341 22.3397L5.49976 15.9292C5.52786 15.6054 5.42347 15.2842 5.21045 15.0388L0.992333 10.1796C0.399403 9.4965 0.746601 8.42794 1.62778 8.22386L7.89649 6.77201C8.21305 6.6987 8.48635 6.50013 8.6539 6.22172L11.9718 0.708465Z" fill="currentColor"></path>
                        </svg>
                      {% endfor %}
                    </span>
                  </div>
                  <p class="rating-text caption">
                    <span aria-hidden="true">
                      {{- product.metafields.reviews.rating.value }} /
                      {{ product.metafields.reviews.rating.value.scale_max -}}
                    </span>
                  </p>
                  <p class="rating-count caption">
                    <span aria-hidden="true"
                      >({{ product.metafields.reviews.rating_count }}
                      {% if product.metafields.reviews.rating_count > 1 %}Reviews{% else %}Review{% endif %})</span
                    >
                    <span class="visually-hidden">
                      {{- product.metafields.reviews.rating_count }}
                      {{ 'accessibility.total_reviews' | t -}}
                    </span>
                  </p>
                </div>
              {%- endif -%}
            {%- when 'complementary' -%}
