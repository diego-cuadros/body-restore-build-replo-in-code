{% style %}
  #shopify-section-{{section.id}} strong {font-weight:700 !important;}
  #shopify-section-{{section.id}} .page-width{ {% if section.settings.width != 0 %} max-width:{{section.settings.width}}px; {% endif %} width:100%;}
  #shopify-section-{{section.id}} {margin-top:{{section.settings.margintop}}px;background:{{ section.settings.background }};}
  #shopify-section-{{section.id}} .bright-video-wrapper{display:grid; align-items: center;}
  #shopify-section-{{section.id}} .bright-video-wrapper.media_first{grid-template-areas:'media content';grid-template-columns:0.75fr 1fr;}
  #shopify-section-{{section.id}} .bright-video-wrapper.content_first{grid-template-areas:'content media';grid-template-columns:1fr 0.75fr;}
  #shopify-section-{{section.id}} .page-width .bright-video-wrapper { gap:48px;}
  #shopify-section-{{section.id}} .bright-video-container{position:relative;padding-top:100%;height:0%;grid-area:media;top:0px;border-radius:10px;overflow:hidden;}
  #shopify-section-{{section.id}} .bright-video-container video{position:absolute;top:0;left:0;height:100%;width:100%;object-fit:cover;object-position:center;}
  #shopify-section-{{section.id}} .bright-video-container img{position:absolute;top:0;left:0;height:100%;width:100%;object-fit:cover;object-position:center;}
  #shopify-section-{{section.id}} .banner_inner_detail .button-landing-banner{cursor:pointer;}
  {% if section.settings.content_position == 'image-first' %}
  #shopify-section-{{section.id}} .bright-video-content-container{grid-area:content;padding:0px 0px 0px 65px;display:flex;flex-direction:column;align-items:center;justify-content:center;}
  {% else %}
  #shopify-section-{{section.id}} .bright-video-content-container{grid-area:content;padding:0px 65px 0px 0px;display:flex;flex-direction:column;align-items:center;justify-content:center;}
  {% endif %}
  #shopify-section-{{section.id}} .bright-video-content-container .bright-video-content {width:100%;display:flex;flex-direction:column;align-items:{{section.settings.align}};justify-content:center;text-align:{{section.settings.align}}; gap:0px;}
  #shopify-section-{{section.id}} .bright-video-content-container .bright-video-content h2 {line-height:1.15;}
  #shopify-section-{{section.id}} .bright-video-content .heading{margin-top:0px;}
  #shopify-section-{{section.id}} .bright-video-content .content{margin-top:0px;}
  #shopify-section-{{section.id}} .bright-video-content .content p{margin:0px;line-height:1.4;}
  #shopify-section-{{section.id}} .bright-video-content .brightangel-button{margin:20px auto 0px;display:flex;}
  #shopify-section-{{section.id}} .speaker-button{position: absolute;top: auto;bottom:20px;left:20px;right: auto;}
  #shopify-section-{{section.id}} .speaker-btn-icons{display:flex;gap:20px;}
  #shopify-section-{{section.id}} .videobtns{cursor:pointer;display: flex;align-items: center;width: 24px;height: 24px;}
  #shopify-section-{{section.id}} .desktop-view {display:block;}
  #shopify-section-{{section.id}} .mobile-view {display:none;}

  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'content' %}
        .block--{{ block.id }} {text-align:{{block.settings.align}};}
    {% endcase %}
  {% endfor %}
  @media screen and (max-width:1200px){

  {% if section.settings.content_position == 'image-first' %}
  #shopify-section-{{section.id}} .bright-video-content-container{grid-area:content;padding:0px 0px 0px 30px;display:flex;flex-direction:column;align-items:center;justify-content:center;}
  {% else %}
  #shopify-section-{{section.id}} .bright-video-content-container{grid-area:content;padding:0px 30px 0px 0px;display:flex;flex-direction:column;align-items:center;justify-content:center;}
  {% endif %}
  }
  @media screen and (max-width:990px){
    #shopify-section-{{section.id}} .bright-video-wrapper{display:grid;/*min-height:calc(100dvh - 135px);max-height:calc(100dvh - 135px);*/height:100%;}
  }
  @media screen and (max-width:768px){
  #shopify-section-{{section.id}} .bright-video-container{position:relative;padding-top:100%;grid-area:media;top:0px; width: 100%;}
  #shopify-section-{{section.id}} .page-width .bright-video-wrapper { gap:0px;}
  #shopify-section-{{section.id}} {margin-top:{{section.settings.margintopmob}}px;}
  #shopify-section-{{section.id}} .heading{margin-top:0px !important;width:100% !important;text-align:{{section.settings.alignmob}}; }
  #shopify-section-{{section.id}} .bright-video-content .content{margin-top:0px;}
  #shopify-section-{{section.id}} .bright-video-wrapper{display:flex;flex-direction:column;}
  #shopify-section-{{section.id}} .bright-video-container{ top:0px;}
  #shopify-section-{{section.id}} .bright-video-content-container{padding:24px 0px;}
  #shopify-section-{{section.id}} .bright-video-content-container .bright-video-content  {display:flex;flex-direction:column;align-items:{{section.settings.alignmob}};justify-content:center;text-align:{{section.settings.alignmob}}; }
  #shopify-section-{{section.id}} .bright-video-content .brightangel-button{margin:12px auto 0px;}
  #shopify-section-{{section.id}} .bright-video-container .custom-controls{position:absolute;z-index:9;bottom:20px;left:20px;}
  #shopify-section-{{section.id}} .desktop-view {display:none;}
  #shopify-section-{{section.id}} .mobile-view {display:block;}

  {% for block in section.blocks %}
    {% case block.type %}
      {% when 'content' %}
        .block--{{ block.id }} {text-align:{{block.settings.alignmob}};}
    {% endcase %}
  {% endfor %}
  }
{% endstyle %}

{% if section.settings.image != blank or section.settings.video_url != blank %}
  <landing-banner data-sectionid="{{ section.id }}">
    <div class="page-width">
      <div
        class="bright-video-wrapper {{ section.settings.content_position }} padding-top-{{ section.settings.padding_top }} padding-bottom-{{ section.settings.padding_bottom }} padding-top-mob-{{ section.settings.mobile_padding_top }} padding-bottom-mob-{{ section.settings.mobile_padding_bottom }}"
      >
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'heading' %}
              <h3
                class="h2  heading mobile-view margin-bottom-{{ block.settings.space }} margin-bottom-mob-{{ block.settings.space_mob }} font-size-mob-{{ block.settings.mobile_size }} font-size-{{ block.settings.size }} font-weight-{{ block.settings.weight }}"
                style="color:{{ block.settings.color }};"
              >
                {{ block.settings.heading }}
              </h3>
          {% endcase %}
        {% endfor %}
        <div class="bright-video-container">
          {% if section.settings.media_type == 'image' %}
            <img
              src="{{ section.settings.image | img_url : 'master' }}"
              {% if section.settings.imagemob != blank %}
                class="desktop-view"
              {% endif %}
            >
            {% if section.settings.imagemob != blank %}
              <img src="{{ section.settings.imagemob | img_url : 'master' }}" class="mobile-view">
            {% endif %}
          {% else %}
            <video
              class="myVideo {% if section.settings.video_urlmob != blank %} desktop-view {% endif %}"
              preload="metadata"
              loop
              playsinline
              muted
              autoplay
            >
              <source src="{{ section.settings.video_url.sources[1].url }}#t=0.001">
              <source src="{{ section.settings.video_url.sources[1].url }}" type="video/quicktime">
              <source src="{{ section.settings.video_url.sources[1].url }}" type="video/mp4">
              <source src="{{ section.settings.video_url.sources[1].url }}" type="video/ogg">
              <source src="{{ section.settings.video_url.sources[1].url }}" type="video/webm">
              <source src="{{ section.settings.video_url.sources[1].url }}" type="video/3gp">
              <source src="{{ section.settings.video_url.sources[1].url }}" type="video/mov">
            </video>
            {% if section.settings.video_urlmob != blank %}
              <video
                class="myVideo mobile-view"
                preload="metadata"
                loop
                playsinline
                muted
                autoplay
              >
                <source src="{{ section.settings.video_urlmob.sources[1].url }}#t=0.001">
                <source src="{{ section.settings.video_urlmob.sources[1].url }}" type="video/quicktime">
                <source src="{{ section.settings.video_urlmob.sources[1].url }}" type="video/mp4">
                <source src="{{ section.settings.video_urlmob.sources[1].url }}" type="video/ogg">
                <source src="{{ section.settings.video_urlmob.sources[1].url }}" type="video/webm">
                <source src="{{ section.settings.video_urlmob.sources[1].url }}" type="video/3gp">
                <source src="{{ section.settings.video_urlmob.sources[1].url }}" type="video/mov">
              </video>
            {% endif %}
          {% endif %}
        </div>
        <div class="bright-video-content-container ">
          <div class="bright-video-content">
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'heading' %}
                  <h2
                    class="h2  heading desktop-view margin-bottom-{{ block.settings.space }} margin-bottom-mob-{{ block.settings.space_mob }} font-size-mob-{{ block.settings.mobile_size }} font-size-{{ block.settings.size }} font-weight-{{ block.settings.weight }}"
                    style="color:{{ block.settings.color }};"
                  >
                    {{ block.settings.heading }}
                  </h2>
                {% when 'content' %}
                  <div
                    class="content block--{{ block.id }} margin-bottom-{{ block.settings.space }} margin-bottom-mob-{{ block.settings.space_mob }} font-size-mob-{{ block.settings.mobile_size }} font-size-{{ block.settings.size }} font-weight-{{ block.settings.weight }}"
                    style="color:{{ block.settings.color }};max-width:{{ block.settings.width }}px;width:100%;"
                  >
                    {{ block.settings.content }}
                  </div>
                {% when 'button' %}
                  {% if block.settings.button != blank %}
                    <div class="banner_inner_detail margin-bottom-{{ block.settings.space }} margin-bottom-mob-{{ block.settings.space_mob }}">
                      <a
                        href="{{ block.settings.link }}"
                        class=" button-landing-banner font-size-mob-{{ block.settings.mobile_size }} font-size-{{ block.settings.size }} font-weight-{{ block.settings.weight }}"
                        style="color:{{ block.settings.color }};"
                      >
                        {{ block.settings.button }}
                      </a>
                    </div>
                  {% endif %}
              {% endcase %}
            {% endfor %}
          </div>
        </div>
      </div>
    </div>
  </landing-banner>
{% endif %}
