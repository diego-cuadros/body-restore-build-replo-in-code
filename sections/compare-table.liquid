<script>
  if (window.screen.width < 769) {
    $( document ).ready(function() {
    $(".prev-btn").click(function() {
      $(this).parent().parent().find(".last").css("display", "none");
      $(this).parent().parent().find(".third").css("display", "flex");
      $(this).siblings(".dots").find(".first").addClass("active");
      $(this).siblings(".dots").find(".second").removeClass("active");
      $(this).css("opacity", "0.5");
      $(this).siblings(".next-btn").css("opacity", "1");
    });
      $(".next-btn").click(function() {
      $(this).parent().parent().find(".last").css("display", "flex");
      $(this).parent().parent().find(".third").css("display", "none");
      $(this).siblings(".dots").find(".first").removeClass("active");
      $(this).siblings(".dots").find(".second").addClass("active");
      $(this).css("opacity", "0.5");
      $(this).siblings(".prev-btn").css("opacity", "1");
    });
  });
  }
</script>
