{% style %}
  .divider{display:block!important;}
{% endstyle %}
<div
  style="background:{{ section.settings.background }};"
  class="divider padding-top-{{ section.settings.padding_top }} padding-bottom-{{ section.settings.padding_bottom }} mobile-padding-top-{{ section.settings.mobile_padding_top }} mobile-padding-bottom-{{ section.settings.mobile_padding_bottom }}"
></div>

{% schema %}
{
  "name": "Divider",
  "settings": [
    {
      "type":"color",
      "id":"background",
      "label":"Background"
    },
    {
      "type":"number",
      "id":"padding_top",
      "label":"Padding Top"
    },
    {
      "type":"number",
      "id":"padding_bottom",
      "label":"Padding Bottom"
    },
    {
      "type":"number",
      "id":"mobile_padding_top",
      "label":"Mobile Padding Top"
    },
    {
      "type":"number",
      "id":"mobile_padding_bottom",
      "label":"Mobile Padding Bottom"
    }
  ],
  "presets": [
    {
      "name":"Divider"
    }
  ]
}
{% endschema %}
