<script>
      $(document).ready(function () {
      $(".media-container").on("click", function () {
        let $popupContainer = $(this).closest(".video-item").find(".main-popup-container");
        let $video = $popupContainer.find("video")[0];

        $popupContainer.show(); // Show the popup
        if ($video) {
          $video.currentTime = 0; // Reset video to start
          $video.play(); // Play video
          $('body').addClass('overflow-hidden');
        }
      });

      $(".cross-popup").on("click", function () {
        let $popupContainer = $(this).closest(".main-popup-container");
        let $video = $popupContainer.find("video")[0];

        if ($video) {
          $video.pause(); // Pause video
          $video.currentTime = 0; // Reset video to start
          $('body').removeClass('overflow-hidden');
        }

        $popupContainer.hide(); // Hide the popup
      });
    });

    $(document).ready(function () {
      $(".tab-items").click(function () {
          var targetTab = $(this).attr("data-tab");

          // Remove 'active' class from all tab items and add it to the clicked one
          $(".tab-items").removeClass("active");
          $(this).addClass("active");

          // Hide all tab content and show the matching one
          $("[data-tab-content]").hide();
          $("[data-tab-content='" + targetTab + "']").show();
      });
  });
</script>
