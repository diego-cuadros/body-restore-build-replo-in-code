{% style %}
  .table--{{ section.id }} .main-container {width:100%;}
  .table--{{ section.id }} .main-container p {margin:0px;}
  .table--{{ section.id }} .title {margin-top:0px;}
  .table--{{ section.id }} .title-container {display:flex;flex-direction:column;align-items:{{section.settings.textalignment}}; text-align:{{section.settings.textalignment}};max-width:{{section.settings.width}}px;width:100%;margin:auto;}
  .table--{{ section.id }} .main-video-container {display:grid;grid-template-columns:repeat({{section.settings.count}} , 1fr);gap:8px;}
  .table--{{ section.id }} .main-video-container .video-item .media-container {width:100%;border-radius:20px;overflow:hidden;position:relative;cursor:pointer;}
  .table--{{ section.id }} .main-video-container .video-item .media-container .media {width:100%;padding-top:{{ section.settings.video-height }}%;position:relative;cursor:pointer;}
  .table--{{ section.id }} .main-video-container .video-item .media-container .media video,
  .table--{{ section.id }} .main-video-container .video-item .media-container .media img {width:100%;height:100%;position:absolute;top:0;right:0;bottom:0;left:0;object-fit:cover;}
  .table--{{ section.id }} .main-video-container .video-item .media-container .media .play-btn {position:absolute;top:0;bottom:0;right:0;left:0;display:flex;flex-direction:row;align-items:center;justify-content:center;}
  .table--{{ section.id }} .main-video-container .video-item .media-container .media .play-btn .icon{position:relative;width:45px;height:45px;border-radius:50%;border:2px solid #ffffff;display:flex;flex-direction:row;align-items:center;justify-content:center;}
  .table--{{ section.id }} .main-video-container .video-item .media-container .media .play-btn .icon svg {width:13px;color:#FFFFFF;}
  .table--{{ section.id }} .main-popup-container {position:fixed;top:0;bottom:0;right:0;left:0;width:100%;height:100%;z-index:99;display:none;}
  .table--{{ section.id }} .main-popup-container .popup-container {position:relative;width:100%;height:100%;display:flex;flex-direction:row;align-items:center;justify-content:center; -webkit-backdrop-filter: blur(5px); backdrop-filter: blur(5px); background-color: #ffffff6b;}
  .table--{{ section.id }} .main-popup-container .popup-container .video-container {position:relative;max-width:360px;width:100%;border-radius:6px;overflow:hidden; }
  .table--{{ section.id }} .main-popup-container .popup-container .video-container .video{width:100%; height:100%;display:flex;}
  .table--{{ section.id }} .main-popup-container .popup-container .video-container video{ width:100%;height:100%; }
  .table--{{ section.id }} .main-popup-container .popup-container .cross-popup-icon {position:absolute;z-index:11;cursor:pointer;top:20px;right:20px;height:40px;width:40px;padding:4px;display:flex;flex-direction:row;align-items:center;justify-content:center;border-radius:100px;background-color:#FFFFFF;}
  .table--{{ section.id }} .main-popup-container .popup-container .cross-popup-icon svg {width:20px;}
  .table--{{ section.id }} .main-popup-container .background-cross {position:absolute;top:0;left:0;right:0;bottom:0;width:100%;height:100%;z-index:5;background:transparent;display:block;}
  .table--{{ section.id }} .tabs-container {width:100%;}
  .table--{{ section.id }} .tabs-container .tab-block {display:flex;flex-direction:row;align-items:center;justify-content:center;}
  .table--{{ section.id }} .tabs-container .tab-block .tab-items {line-height:1.2;color: {{section.settings.tab-color}}; text-align: center; cursor: pointer; background-color: transparent;padding: 16px 24px; font-size: 16px; font-weight: 500; transition: background-color .2s;border-radius:20px 20px 0px 0px;}
  .table--{{ section.id }} .tabs-container .tab-block .tab-items.active {background-color:#FFFFFF;}
  .table--{{ section.id }} .widget-container {display:none;}

  @media screen and (max-width:768px){
  .table--{{ section.id }} .main-video-container {display:grid;grid-template-columns:repeat({{section.settings.count-mob}} , 1fr);gap:8px;}
  }
{% endstyle %}

<section
  class="table--{{ section.id }} padding-bottom-{{ section.settings.padding_bottom }} padding-bottom-mob-{{ section.settings.mobile_padding_bottom }}"
>
  <div class="main-container">
    <div
      class="header-container  padding-top-{{ section.settings.padding_top }} padding-top-mob-{{ section.settings.mobile_padding_top }} "
      style="background:{{ section.settings.bg-color }};"
    >
      <div class="page-width">
        <div class="title-container">
          {% if section.settings.caption != blank %}
            <h5
              class="caption margin-bottom-{{ section.settings.cspace }} margin-bottom-mob-{{ section.settings.cspace_mob }} font-size-{{ section.settings.cfont-size }} font-weight-{{ section.settings.cfont-weight }} font-size-mob-{{ section.settings.cfont-size-mob }}"
              style="color:{{ section.settings.ccolor }};margin-top:0px;"
            >
              {{ section.settings.caption }}
            </h5>
          {% endif %}
          {% if section.settings.title != blank %}
            <h2
              class="h3 title margin-bottom-{{ section.settings.space }} margin-bottom-mob-{{ section.settings.space_mob }} font-size-{{ section.settings.font-size }} font-weight-{{ section.settings.font-weight }} font-size-mob-{{ section.settings.font-size-mob }}"
              style="color:{{ section.settings.color }};margin-top:0px;"
            >
              {{ section.settings.title }}
            </h2>
          {% endif %}
          {% if section.settings.content != blank %}
            <div
              class="content margin-bottom-{{ section.settings.tcspace }} margin-bottom-mob-{{ section.settings.tcspace_mob }} font-size-{{ section.settings.tcfont-size }} font-weight-{{ section.settings.tcfont-weight }} font-size-mob-{{ section.settings.tcfont-size-mob }}"
              style="color:{{ section.settings.tccolor }};"
            >
              {{ section.settings.content }}
            </div>
          {% endif %}
        </div>
        <div class="tabs-container">
          <div class="tab-block">
            <div class="tab-items active" data-tab="tab-video-container">
              <div
                class="text font-size-{{ section.settings.tabfont-size }} font-weight-{{ section.settings.tabfont-weight }} font-size-mob-{{ section.settings.tabfont-size-mob }}"
              >
                {{ section.settings.tab1 }}
              </div>
            </div>
            <div class="tab-items" data-tab="tab-widget-container">
              <div
                class="text font-size-{{ section.settings.tabfont-size }} font-weight-{{ section.settings.tabfont-weight }} font-size-mob-{{ section.settings.tabfont-size-mob }}"
              >
                {{ section.settings.tab2 }}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="content-container-main" style="background:#FFFFFF;">
      <div class="page-width">
        <div class="main-content-container margin-top-40">
          <div data-tab-content="tab-video-container" class="block-video-container">
            <div class="main-video-container">
              {% for block in section.blocks %}
                {% case block.type %}
                  {% when 'video' %}
                    <div class="video-item">
                      <div class="media-container">
                        <div class="media">
                          {% if block.settings.image != blank %}
                            <img src="{{ block.settings.image | img_url : 'master' }}">
                          {% else %}
                            <img src="{{ block.settings.video.preview_image | img_url : 'master' }}">
                          {% endif %}
                          <div class="play-btn">
                            <div class="icon">
                              <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%" viewBox="0 0 110 110">
                                <g id="Group_1" data-name="Group 1" transform="translate(-597 675)">
                                  <rect id="Rectangle_1" data-name="Rectangle 1" width="110" height="110" transform="translate(597 -675)" fill="#fff" opacity="0"></rect>
                                  <path id="Polygon_1" data-name="Polygon 1" d="M55,0l55,77H0Z" transform="translate(697 -675) rotate(90)" fill="currentColor"></path>
                                </g>
                              </svg>
                            </div>
                          </div>
                        </div>
                      </div>
                      <div class="main-popup-container">
                        <div class="popup-container cross-popup">
                          <div class="video-container">
                            <div class="cross-popup cross-popup-icon">
                              <svg
                                xmlns="http://www.w3.org/2000/svg"
                                xmlns:xlink="http://www.w3.org/1999/xlink"
                                aria-hidden="true"
                                role="img"
                                class="iconify iconify--ic"
                                width="100%"
                                height="100%"
                                preserveAspectRatio="xMidYMid meet"
                                viewBox="0 0 24 24"
                              >
                                <path fill="currentColor" d="M18.3 5.71a.996.996 0 0 0-1.41 0L12 10.59L7.11 5.7A.996.996 0 1 0 5.7 7.11L10.59 12L5.7 16.89a.996.996 0 1 0 1.41 1.41L12 13.41l4.89 4.89a.996.996 0 1 0 1.41-1.41L13.41 12l4.89-4.89c.38-.38.38-1.02 0-1.4z"></path>
                              </svg>
                            </div>
                            <div class="video">
                              {{-
                                block.settings.video
                                | video_tag:
                                  controls: true,
                                  playsinline: true,
                                  muted: false,
                                  autoplay: false,
                                  loop: true,
                                  preload: 'metadata',
                                  class: 'video-meta',
                                  poster: ''
                                | replace: '<img ', '<img loading="lazy" '
                              -}}
                            </div>
                          </div>
                        </div>
                        <!-- <div class="background-cross cross-popup"></div> -->
                      </div>
                    </div>
                {% endcase %}
              {% endfor %}
            </div>
          </div>
          <div data-tab-content="tab-widget-container" class="widget-container">
            {% render 'okendo-reviews-widget' %}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

