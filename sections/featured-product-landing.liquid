                      </div>
                      {% if block.settings.text2 != blank %}
                        <div
                          class="text margin-top-{{ block.settings.space }} margin-top-mob-{{ block.settings.space_mob }} font-size-mob-{{ block.settings.mobile_size }} font-size-{{ block.settings.size }} font-weight-{{ block.settings.weight }}"
                          style="color:{{ block.settings.color }};"
                        >
                          {{ block.settings.text2 }}
                        </div>
                      {% endif %}
                    </div>
                    <div class="gif-item">
                      <div
                        class="image"
                        style="border:3px solid {{ block.settings.bordercolor }};border-radius:{{ block.settings.borderradius }}%;"
                      >
                        {% if block.settings.media == 'video' %}
                          <video
                            preload="metadata"
