                      >
                        {% if block.settings.media == 'video' %}
                          <video
                            preload="metadata"
                            loop
                            playsinline
                            muted
                            autoplay
                          >
                            <source src="{{ block.settings.video1 }}#t=0.001">
                            <source src="{{ block.settings.video1 }}" type="video/quicktime">
                            <source src="{{ block.settings.video1 }}" type="video/mp4">
                            <source src="{{ block.settings.video1 }}" type="video/ogg">
                            <source src="{{ block.settings.video1 }}" type="video/webm">
                            <source src="{{ block.settings.video1 }}" type="video/3gp">
