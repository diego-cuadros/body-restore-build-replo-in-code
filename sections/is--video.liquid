{% comment %}
<h1>Video Player</h1>
<div class="video-wrapper">
	<div class="video-container" id="video-container">
		<video controls id="video" preload="metadata" poster="//cdn.jsdelivr.net/npm/big-buck-bunny-1080p@0.0.6/poster.jpg">
			<source src="//cdn.jsdelivr.net/npm/big-buck-bunny-1080p@0.0.6/video.mp4" type="video/mp4">
		</video>
		<div class="play-button-wrapper">
			<div title="Play video" class="play-gif" id="circle-play-b">
				<!-- SVG Play Button -->
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80">
					<path d="M40 0a40 40 0 1040 40A40 40 0 0040 0zM26 61.56V18.44L64 40z" />
				</svg>
			</div>
		</div>
	</div>
	<div class="video-container" id="video-container">
		<video controls id="video" preload="metadata" poster="//cdn.jsdelivr.net/npm/big-buck-bunny-1080p@0.0.6/poster.jpg">
			<source src="//cdn.jsdelivr.net/npm/big-buck-bunny-1080p@0.0.6/video.mp4" type="video/mp4">
		</video>
		<div class="play-button-wrapper">
			<div title="Play video" class="play-gif" id="circle-play-b">
				<!-- SVG Play Button -->
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80">
					<path d="M40 0a40 40 0 1040 40A40 40 0 0040 0zM26 61.56V18.44L64 40z" />
				</svg>
			</div>
		</div>
	</div>
</div>
{% endcomment %}
<script>
$(document).ready(function() {
    $(".circle-play-b").on("click", function() {
        var video = $(this).closest(".video-container").find(".video")[0];
        togglePlay(video, $(this));
    });

    $(".video").on("playing", function() {
        $(this).siblings(".play-button-wrapper").find(".circle-play-b").css("opacity", 0);
    });

    $(".video").on("pause", function() {
        $(this).siblings(".play-button-wrapper").find(".circle-play-b").css("opacity", 1);
    });
});

function togglePlay(video, button) {
    if (video.paused || video.ended) {
        video.play();
    } else {
        video.pause();
    }
}


</script>
                      
