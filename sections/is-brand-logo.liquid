<div class="brand_logo_sec">
  <div class="container">
    {% if section.settings.logo_title != blank %}
      <div class="def_title">
        <h6>{{ section.settings.logo_title }}</h6>
      </div>
    {% endif %}
    <div class="logo_grid">
      <div class="logo_row">
        {%- for block in section.blocks -%}
          {% if block.settings.brand_logo_img != blank %}
            <div class="logo_col">
              {% if block.settings.brand_logo_url != blank %}<a href="{{ block.settings.brand_logo_url }}">{% endif %}
                <img src="{{ block.settings.brand_logo_img | img_url : "master" }}" alt="Brand Logo {{ forloop.index }}" />
              {% if block.settings.brand_logo_url != blank %}</a>{% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Brand Logo",
    "settings": [
      {
        "type": "textarea",
        "id": "logo_title",
        "label": "Title"
      }
    ],
    "blocks": [
      {
        "type": "@app"
      },
      {
        "type": "brand_logo",
        "name": "Brand Logo Lits",
        "settings": [
          {
            "type": "image_picker",
            "id": "brand_logo_img",
            "label": "Logo"
          },
          {
            "type": "url",
            "id": "brand_logo_url",
            "label": "URL"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Brand Logo"
      }
    ]
  }
{% endschema %}

{% stylesheet %}
{% endstylesheet %}

{% javascript %}
{% endjavascript %}