{% style %}
  #shopify-section-{{section.id}} .cmt_container{width:100%;overflow: hidden;}
  #shopify-section-{{section.id}} .cmt_inner{width:100%; display:grid; grid-template-columns: repeat(2, 1fr); gap:16px; {% if section.settings.max_width > 0 %} max-width: {{section.settings.max_width}}px;{% endif %} }
  #shopify-section-{{section.id}} .cmt_media_box{width:100%; order:{{section.settings.image_position}};display:flex;align-items:center;justify-content:center;}
  #shopify-section-{{section.id}} .cmt_image_box{width:100%;height:100%;position:relative;min-height:435px;}
  #shopify-section-{{section.id}} .cmt_image{width:100%;height:100%;position:relative;overflow:hidden;border-radius:8px;}
  #shopify-section-{{section.id}} .cmt_image img{width:100%;height:100%;object-fit:cover;object-position:center center;}
  #shopify-section-{{section.id}} .cmt_logo_img_box{width: {{ section.settings.logo_image_size }}px;position: absolute; bottom: -{{ section.settings.verticaly_align }}px; {% if section.settings.image_position != "2" %}left: -{{ section.settings.horizontal_align }}px; {%else%} right: -{{ section.settings.horizontal_align }}px;{% endif %} }
  #shopify-section-{{section.id}} .cmt_logo_img_box img{width:100%;height:auto;object-fit:contain;}

  #shopify-section-{{section.id}} .cmt_logo_img.mobile{display:none;}


  #shopify-section-{{section.id}} .cmt_content_box{width:100%; display:flex;justify-content:center;align-items:center;}
  #shopify-section-{{section.id}} .cmt_content_inner{width:100%;display:flex;flex-direction:column;height:100%;}
  #shopify-section-{{section.id}} .cmt_heading{text-transform:uppercase;letter-spacing:-1px;line-height:1.4;}
  #shopify-section-{{section.id}} .cmt_text{font-family:"Roboto"; line-height:1.5;letter-spacing:0px;}
  #shopify-section-{{section.id}} .cmt_text p{font-family:"Roboto";margin:0px !important; letter-spacing:0px;}

  #shopify-section-{{section.id}} .cmt_review_box{width:100%;padding:26px; border-radius:4px;margin-top:auto;}
  #shopify-section-{{section.id}} .cmt_review_inner{width:100%;display:grid; grid-template-columns:80px 1fr;gap:20px;align-items:center;}
  #shopify-section-{{section.id}} .cmt_review_item{width:100%;display:flex;flex-direction:column;align-items:center;gap:4px;}
  #shopify-section-{{section.id}} .cmt_review_item_img{width:100%;display:flex;justify-content:center;align-items:center;}
  #shopify-section-{{section.id}} .cmt_review_item_img img{width:100%;height:auto;object-fit:contain;}
  #shopify-section-{{section.id}} .cmt_rating_stars{width:100%;display:flex;justify-content:center;align-items:center;}
  #shopify-section-{{section.id}} .cmt_review_content_box{width:100%;}
  #shopify-section-{{section.id}} .cmt_review_content{width:100%;}
  #shopify-section-{{section.id}} .cmt_review_content p{margin:0;line-height:1.3;letter-spacing:0px;}
  #shopify-section-{{section.id}} .cmt_review_content_bottom{width:100%;display:flex; justify-content:space-between;align-items:center; column-gap:15px;row-gap:10px;flex-wrap:wrap;}
  #shopify-section-{{section.id}} .cmt_review_content_bottom_text{width:fit-content;text-transform:capitalize; letter-spacing:0.32px;line-height:1.2;}
  #shopify-section-{{section.id}} .cmt_verified{width:fit-content;display:flex;justify-content:center;align-items:center;gap:4px;font-size:12px;line-height:16.8px;letter-spacing:0.6px;font-weight:600;color:#426640;}


  @media screen and (max-width:990px){
  #shopify-section-{{section.id}} .cmt_inner{grid-template-columns: 1fr; gap:30px; }
  #shopify-section-{{section.id}} .cmt_image_box{width:100%;height:unset;position:relative;min-height:unset;}
  #shopify-section-{{section.id}} .cmt_image{aspect-ratio:4/3;}
  #shopify-section-{{section.id}} .cmt_media_box{order:0;}
  }
  @media screen and (max-width:749px){
  #shopify-section-{{section.id}} .cmt_logo_img.mobile{display:block;}
  #shopify-section-{{section.id}} .cmt_logo_img.desktop{display:none;}
  #shopify-section-{{section.id}} .cmt_logo_img_box{width:  {{ section.settings.logo_image_size_mob }}px; bottom: -{{ section.settings.verticaly_align_mob }}px; {% if section.settings.image_position != "2" %}left: -{{ section.settings.horizontal_align_mob }}px; {%else%} right: -{{ section.settings.horizontal_align_mob }}px;{% endif %} }
  #shopify-section-{{section.id}} .cmt_review_box{width:100%;padding:20px 15px;}
  #shopify-section-{{section.id}} .cmt_review_inner{ grid-template-columns:60px 1fr;gap:15px;}

  }
{% endstyle %}

<div
  class="cmt_container padding-top-{{ section.settings.sec_top_padding }} padding-top-mob-{{ section.settings.sec_top_padding_mob }} padding-bottom-{{ section.settings.sec_bottom_padding }} padding-bottom-mob-{{ section.settings.sec_bottom_padding_mob }}"
  style="background:{{ section.settings.sec_bg }};"
>
  <div class="cmt_inner page-width">
    <div class="cmt_media_box">
      <div class="cmt_image_box">
        <div class="cmt_image">
          <img src="{{ section.settings.main_image | img_url:"master" }}" class="main_img">
        </div>
        {% if section.settings.logo_img != blank %}
          <div class="cmt_logo_img_box">
            <img src="{{ section.settings.logo_img | img_url:"master" }}" class="cmt_logo_img desktop">
            <img src="{{ section.settings.logo_img_mob | img_url:"master" }}" class="cmt_logo_img mobile">
          </div>
        {% endif %}
      </div>
    </div>
    <div class="cmt_content_box">
      <div class="cmt_content_inner">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'heading' %}
              <div
                class="cmt_heading font-size-{{ block.settings.font_size }} font-size-mob-{{ block.settings.font_size_mob }} font-weight-{{ block.settings.font_weight }} margin-bottom-{{ block.settings.margin_bottom }} margin-bottom-mob-{{ block.settings.margin_bottom_mob }}"
                style="color:{{ block.settings.text_color }}"
              >
                {{ block.settings.heading }}
              </div>
            {% when 'content' %}
              <div
                class="cmt_text font-size-{{ block.settings.font_size }} font-size-mob-{{ block.settings.font_size_mob }} font-weight-{{ block.settings.font_weight }} margin-bottom-{{ block.settings.margin_bottom }} margin-bottom-mob-{{ block.settings.margin_bottom_mob }}"
                style="color:{{ block.settings.text_color }}"
              >
                {{ block.settings.content }}
              </div>
            {% when 'review' %}
              <div
                class="cmt_review_box"
                style="background:{{ block.settings.review_box_bg }}; border: 2px solid {{ block.settings.review_box_border_color }};"
              >
                <div class="cmt_review_inner">
                  <div class="cmt_review_item">
                    <div class="cmt_review_item_img">
                      <img src="{{ block.settings.img | img_url:"master"}}">
                    </div>
                    <div class="cmt_rating_stars">
                      <svg xmlns="http://www.w3.org/2000/svg" width="76" height="14" viewBox="0 0 76 14" fill="none">
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M7.66271 11.4569C7.44522 11.3426 7.18541 11.3426 6.96792 11.4569L4.24866 12.8863C3.70086 13.1741 3.06068 12.7089 3.16533 12.099L3.68458 9.07218C3.72613 8.82999 3.64581 8.58277 3.46979 8.41123L1.27031 6.26774C0.827059 5.83578 1.0716 5.08306 1.68409 4.99408L4.72398 4.55245C4.96717 4.51713 5.1774 4.3644 5.28617 4.14404L6.64577 1.3898C6.91969 0.83491 7.71091 0.83491 7.98485 1.3898L9.34449 4.14404C9.45323 4.3644 9.66351 4.51713 9.90665 4.55245L12.9466 4.99408C13.559 5.08306 13.8036 5.83578 13.3603 6.26774L11.1609 8.41123C10.9848 8.58277 10.9045 8.82999 10.9461 9.07218L11.4653 12.099C11.57 12.7089 10.9298 13.1741 10.382 12.8863L7.66271 11.4569Z" fill="#FCB800" stroke="black" stroke-width="0.892783"/>
