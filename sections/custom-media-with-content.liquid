                        <path fill-rule="evenodd" clip-rule="evenodd" d="M54.1148 11.4569C53.8972 11.3426 53.6375 11.3426 53.42 11.4569L50.7007 12.8863C50.1529 13.1741 49.5128 12.7089 49.6174 12.099L50.1367 9.07218C50.1782 8.82999 50.0979 8.58277 49.9219 8.41123L47.7224 6.26774C47.2792 5.83578 47.5237 5.08306 48.1362 4.99408L51.1761 4.55245C51.4193 4.51713 51.6295 4.3644 51.7382 4.14404L53.0978 1.3898C53.3718 0.83491 54.163 0.83491 54.437 1.3898L55.7965 4.14404C55.9053 4.3644 56.1155 4.51713 56.3587 4.55245L59.3987 4.99408C60.0111 5.08306 60.2557 5.83578 59.8124 6.26774L57.6129 8.41123C57.437 8.58277 57.3566 8.82999 57.3982 9.07218L57.9174 12.099C58.022 12.7089 57.3819 13.1741 56.8341 12.8863L54.1148 11.4569Z" fill="#FCB800" stroke="black" stroke-width="0.892783"/>
                        <path fill-rule="evenodd" clip-rule="evenodd" d="M69.5988 11.4569C69.3813 11.3426 69.1214 11.3426 68.904 11.4569L66.1847 12.8863C65.637 13.1741 64.9968 12.7089 65.1014 12.099L65.6207 9.07218C65.6622 8.82999 65.5819 8.58277 65.4059 8.41123L63.2064 6.26774C62.7632 5.83578 63.0077 5.08306 63.6202 4.99408L66.6601 4.55245C66.9033 4.51713 67.1135 4.3644 67.2222 4.14404L68.5818 1.3898C68.8558 0.83491 69.647 0.83491 69.921 1.3898L71.2805 4.14404C71.3893 4.3644 71.5995 4.51713 71.8428 4.55245L74.8827 4.99408C75.4951 5.08306 75.7396 5.83578 75.2964 6.26774L73.0969 8.41123C72.9209 8.58277 72.8406 8.82999 72.8822 9.07218L73.4013 12.099C73.506 12.7089 72.8659 13.1741 72.3181 12.8863L69.5988 11.4569Z" fill="#FCB800" stroke="black" stroke-width="0.892783"/>
                      </svg>
                    </div>
                  </div>
                  <div class="cmt_review_content_box">
                    <div
                      class="cmt_review_content font-size-{{ block.settings.font_size }} font-size-mob-{{ block.settings.font_size_mob }} font-weight-{{ block.settings.font_weight }} margin-bottom-{{ block.settings.margin_bottom }} margin-bottom-mob-{{ block.settings.margin_bottom_mob }}"
                      style="color:{{ block.settings.text_color }};"
                    >
                      {{ block.settings.review_text }}
                    </div>
                    <div class="cmt_review_content_bottom">
                      <div
                        class="cmt_review_content_bottom_text font-size-{{ block.settings.r_font_size }} font-size-mob-{{ block.settings.r_font_size_mob }} font-weight-{{ block.settings.r_font_weight }}"
                        style="color:{{ block.settings.r_color }}"
                      >
                        {{ block.settings.regards }}
                      </div>
                      <div class="cmt_verified">
                        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 17 17" fill="none">
                          <path d="M10.7751 0L8.5 1.46028L6.22184 0L4.98014 2.40336L2.27713 2.27713L2.40336 4.97911L0 6.22184L1.46028 8.5L0 10.7751L2.40336 12.0178L2.27713 14.7198L4.97911 14.5936L6.22081 16.9969L8.49795 15.5366L10.7751 16.999L12.0178 14.5956L14.7198 14.7218L14.5946 12.0199L16.999 10.7751L15.5397 8.5L17 6.22287L14.5966 4.98117L14.7218 2.27919L12.0199 2.40438L10.7751 0Z" fill="#426640"/>
                          <path d="M7.12976 11.6671L4.60941 9.14882C4.53685 9.07609 4.49609 8.97755 4.49609 8.87482C4.49609 8.77209 4.53685 8.67355 4.60941 8.60083L5.1574 8.05284C5.23013 7.98027 5.32866 7.93951 5.4314 7.93951C5.53413 7.93951 5.63267 7.98027 5.70539 8.05284L7.40375 9.75017L11.0406 6.11332C11.1133 6.04075 11.2119 6 11.3146 6C11.4173 6 11.5159 6.04075 11.5886 6.11332L12.1366 6.66131C12.2091 6.73403 12.2499 6.83257 12.2499 6.93531C12.2499 7.03804 12.2091 7.13658 12.1366 7.2093L7.67672 11.6671C7.60404 11.7394 7.50572 11.7799 7.40324 11.7799C7.30076 11.7799 7.20244 11.7394 7.12976 11.6671Z" fill="white"/>
                        </svg>
                        Verified Buyer
                      </div>
                    </div>
                  </div>
                </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Custom Image and Content",
  "settings": [
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Section Background"
    },
    {
      "type": "number",
      "id": "max_width",
      "default":1218,
      "label": "Section Width"
    },
    {
      "type": "header",
      "content": "Media Box"
    },
    {
      "type": "select",
      "id": "image_position",
      "options": [
        {
          "value": "0",
          "label": "Left",
        },
        {
          "value": "2",
          "label": "Right",
        },
      ],
      "default":"0",
      "label": "Media Position"
    },
    {
      "type": "image_picker",
      "id": "main_image",
      "label": "Image"
    },
    {
      "type": "image_picker",
      "id": "logo_img",
      "label": "Small Image",
    },
    {
      "type": "number",
      "id": "logo_image_size",
      "default":200,
      "label":"Small Image width"
    },
    {
      "type": "range",
      "id": "verticaly_align",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 1,
      "default":50,
      "label": "Set Position Vertically"
    },
    {
      "type": "range",
      "id": "horizontal_align",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 1,
      "default":50,
      "label": "Set Position Horizontal"
    },
    {
      "type": "image_picker",
      "id": "logo_img_mob",
      "label": "Mobile Small Image",
    },
    {
      "type": "number",
      "id": "logo_image_size_mob",
      "default":150,
      "label":"Mobile Small Image width"
    },
    {
      "type": "range",
      "id": "verticaly_align_mob",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 1,
      "default":20,
      "label": "Set Position Vertically"
    },
    {
      "type": "range",
      "id": "horizontal_align_mob",
      "unit": "px",
      "min": 0,
      "max": 100,
      "step": 1,
      "default":20,
      "label": "Set Position Horizontal"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "number",
      "id": "sec_top_padding",
      "label": "Top Spacing",
    },
    {
      "type": "number",
      "id": "sec_bottom_padding",
      "label": "Bottom Spacing",
    },
    {
      "type": "number",
      "id": "sec_top_padding_mob",
      "label": "Mobile Top Spacing",
    },
    {
      "type": "number",
      "id": "sec_bottom_padding_mob",
      "label": "Mobile Bottom Spacing",
    },
  ],
  "blocks": [
    {
      "type": "heading",
      "name":"Heading",
      "settings": [
        {
          "type": "text",
          "id":"heading",
          "label": "Add Text",
        },
        {
          "type": "color",
          "id": "text_color",
          "default":"#0C2331",
          "label": "Text Color"
        },
        {
          "type": "range",
          "id": "font_size",
          "unit": "px",
          "min": 0,
          "max": 100,
          "step": 1,
          "default":32,
          "label": "Font Size",
        },
        {
          "type": "range",
          "id": "font_size_mob",
          "unit": "px",
          "min": 0,
          "max": 100,
          "step": 1,
          "default":20,
          "label": "Mobile Font Size",
        },
        {
          "type": "range",
          "id": "font_weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default":700,
          "label": "Font Weight",
        },
        {
          "type": "number",
          "id": "margin_bottom",
          "default": 10,
          "label": "Bottom Spacing"
        },
        {
          "type": "number",
          "id": "margin_bottom_mob",
          "default": 10,
          "label": "Mobile Bottom Spacing"
        }
      ]
    },
    {
      "type": "content",
      "name":"Content",
      "settings": [
        {
          "type": "richtext",
          "id":"content",
          "label": "Add Text",
        },
        {
          "type": "color",
          "id": "text_color",
          "default":"#0C2331",
          "label": "Text Color"
        },
        {
          "type": "range",
          "id": "font_size",
          "unit": "px",
          "min": 0,
          "max": 100,
          "step": 1,
          "default":16,
          "label": "Font Size",
        },
        {
          "type": "range",
          "id": "font_size_mob",
          "unit": "px",
          "min": 0,
          "max": 100,
          "step": 1,
          "default":16,
          "label": "Mobile Font Size",
        },
        {
          "type": "range",
          "id": "font_weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default":400,
          "label": "Font Weight",
        },
        {
          "type": "number",
          "id": "margin_bottom",
          "default": 0,
          "label": "Bottom Spacing"
        },
        {
          "type": "number",
          "id": "margin_bottom_mob",
          "default": 0,
          "label": "Mobile Bottom Spacing"
        }
      ]
    },
    {
      "type": "review",
      "name":"Review Block",
      "limit": 1,
      "settings": [
        {
          "type": "color",
          "id": "review_box_bg",
          "default":"#E2EDEC",
          "label": "Background Color"
        },
        {
          "type": "color",
          "id": "review_box_border_color",
          "default":"#00BCAE",
          "label": "Border Color"
        },
        {
          "type": "image_picker",
          "id": "img",
          "label": "Item Image"
        },
        {
          "type": "header",
          "content": "Review Content"
        },
        {
          "type": "richtext",
          "id": "review_text",
          "label": "Add Text"
        },
               {
          "type": "color",
          "id": "text_color",
        "default":"#000000",
          "label": "Text Color"
        },
        {
          "type": "range",
          "id": "font_size",
          "unit": "px",
          "min": 0,
          "max": 100,
          "step": 1,
          "default":14,
          "label": "Font Size",
        },
        {
          "type": "range",
          "id": "font_size_mob",
          "unit": "px",
          "min": 0,
          "max": 100,
          "step": 1,
          "default":14,
          "label": "Mobile Font Size",
        },
        {
          "type": "range",
          "id": "font_weight",
          "min": 100,
          "max": 900,
          "step": 100,
          "default":600,
          "label": "Font Weight",
        },
        {
          "type": "number",
          "id": "margin_bottom",
          "default": 10,
          "label": "Bottom Spacing"
        },
        {
          "type": "number",
          "id": "margin_bottom_mob",
          "default": 10,
          "label": "Mobile Bottom Spacing"
        },
        {
          "type": "header",
          "content": "Review Regards"
        },
        {
          "type": "text",
          "id": "regards",
          "label": "Add Text"
        },
               {
          "type": "color",
          "id": "r_color",
          "default":"#000000",
          "label": "Text Color"
        },
        {
          "type": "range",
          "id": "r_font_size",
          "unit": "px",
          "min": 0,
          "max": 100,
          "step": 1,
          "default":14,
          "label": "Font Size",
        },
        {
          "type": "range",
          "id": "r_font_size_mob",
          "unit": "px",
