          "label":"Content First"
        }
      ],
      "default":"media_first",
      "label":"Position"
    },
    {
      "type":"select",
      "id":"media_type",
      "options":[
        {
          "value":"video",
          "label":"Video"
        },
        {
          "value":"image",
          "label":"Image"
        }
      ],
      "default":"image",
      "label":"Media Type"
    },
    {
      "type":"number",
      "label":"Media Height",
      "id":"mediaheight",
      "default":100
    },
    {
      "type":"image_picker",
      "id":"image",
      "label":"Image",
      "info":"Please upload 1000 x 1000 px size image"
    },
    {
      "type": "video",
