<script>
      // $('.myVideo').each(function(index, video) {
      //   var $muteBtn = $(video).closest('.bright-video-container').find('.muteBtn');

      //   $muteBtn.on('click', function() {
      //     if (video.muted) {
      //       video.muted = false;
      //       $muteBtn.find('.mute').hide();
      //       $muteBtn.find('.unmute').show();
      //     } else {
      //       video.muted = true;
      //       $muteBtn.find('.mute').show();
      //       $muteBtn.find('.unmute').hide();
      //     }
      //   });
      // });


   $('.myVideo').each(function(index, video) {
    var $container = $(video).closest('.bright-video-container');
    var $muteBtn = $container.find('.muteBtn');
    var $pauseBtn = $container.find('.pause-button');

    // Mute/Unmute Functionality
    $muteBtn.on('click', function() {
      if (video.muted) {
        video.muted = false;
        $muteBtn.find('.mute').css('display', 'none');
        $muteBtn.find('.unmute').css('display', 'flex');
      } else {
        video.muted = true;
        $muteBtn.find('.mute').css('display', 'flex');
        $muteBtn.find('.unmute').css('display', 'none');
      }
    });

    // Play/Pause Functionality
    $pauseBtn.on('click', function() {
      if (video.paused) {
        video.play();
        $pauseBtn.find('.pause').css('display', 'flex');
        $pauseBtn.find('.play').css('display', 'none');
      } else {
        video.pause();
        $pauseBtn.find('.pause').css('display', 'none');
        $pauseBtn.find('.play').css('display', 'flex');
      }
    });
  });
</script>
