    },
    {
      "type":"header",
      "content":"Item Customization"
    },
    {
      "type":"header",
      "content":"Item Title Customization"
    },
    {
      "type":"color",
      "id":"itcolor",
      "label":"Color"
    },
    {
      "type":"range",
      "id":"itsize",
      "min":0,
      "max":100,
      "default":28,
      "label":"Font Size"
    },
    {
      "type":"range",
      "id":"itmobile_size",
      "min":0,
      "max":100,
      "default":28,
      "label":"Mobile Font Size"
    },
    {
      "type":"range",
      "id":"itweight",
      "step":100,
      "min":100,
      "max":900,
      "default":500,
      "label":"Font Weight"
    },
    {
      "type":"header",
      "content":"Item Text Customization"
    },
    {
      "type":"color",
      "id":"iccolor",
      "label":"Color"
    },
    {
      "type":"range",
      "id":"icsize",
      "min":0,
      "max":100,
      "default":16,
      "label":"Font Size"
    },
    {
      "type":"range",
      "id":"icmobile_size",
      "min":0,
      "max":100,
      "default":16,
      "label":"Mobile Font Size"
    },
    {
      "type":"range",
      "id":"icweight",
      "step":100,
      "min":100,
      "max":900,
      "default":500,
      "label":"Font Weight"
    },
    {
      "type":"header",
      "content":"Section Spacing"
    },
    {
      "type":"number",
      "id":"padding_top",
      "label":"Padding Top"
    },
    {
      "type":"number",
      "id":"padding_bottom",
      "label":"Padding Bottom"
    },
    {
      "type":"number",
      "id":"mobile_padding_top",
      "label":"Mobile Padding Top"
    },
    {
      "type":"number",
      "id":"mobile_padding_bottom",
      "label":"Mobile Padding Bottom"
