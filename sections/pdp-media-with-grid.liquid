      "label":"Mobile Margin Top"
    }
  ],
  "blocks":[
    {
      "type":"item",
      "name":"Item",
      "settings":[
        {
          "type":"text",
          "id":"heading",
          "label":"Heading"
        },
        {
          "type":"richtext",
          "id":"content",
          "label":"Content"
        },
      ]
    }
  ],
  "presets":[
    {
    "name": "PDP Media With Grid"
    }
  ]
