    },
    {
      "type": "range",
      "id": "opacity-mob",
      "min": 0,
      "max": 99,
      "step": 1,
      "default": 20,
      "label":"Mobile banner Overlay"
    },
    {
      "type":"header",
      "content":"Image Height Customization"
    },
    {
      "type": "select",
      "default": "small",
      "options": [
        {
          "label": "Small",
          "value": "small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "x-large",
          "label": "X Large"
        }
      ],
      "id": "image_height",
      "label":"Image Height"
    },
    {
      "type": "select",
      "default": "mobile_small",
      "options": [
        {
          "label": "Extra Small",
          "value": "mobile_xsmall"
        },
        {
          "label": "Small",
          "value": "mobile_small"
        },
        {
          "value": "mobile_medium",
          "label": "Medium"
        },
        {
          "value": "mobile_large",
          "label": "Large"
        },
        {
          "value": "mobile_x-large",
          "label": "X Large"
        }
      ],
      "id": "mobile_image_height",
      "label":"Mobile Image Height",
      "info":"It works when the content position is overlay."
    },
    {
      "type":"header",
      "content":"content Position Customization"
    },
    {
      "type": "select",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "end",
          "label": "Right"
        }
      ],
      "default": "start",
      "id": "position",
      "label":"Desktop Content Position"
    },
    {
      "type": "select",
      "options": [
        {
          "label": "overlay Image",
          "value": "overlay"
        },
        {
          "label": "Above Image",
          "value": "above"
        },
        {
          "value": "below",
          "label": "below Image"
        }
      ],
      "id": "mobile_position",
      "label":"Mobile Content Position"
    },
    {
      "type": "range",
      "id": "imageheight",
      "min": 25,
      "max": 125,
      "step": 1,
      "default": 56,
      "label":"Mobile Image Height",
      "info":"It works when the content position is above and below."
    },
    {
      "type":"header",
      "content":"Content Alignment Customization"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "options": [
        {
          "value": "top-left",
          "label": "Top Left"
        },
        {
          "value": "top-center",
          "label": "Top Center"
        },
        {
          "value": "top-right",
          "label": "Top Right"
        },
        {
          "value": "middle-left",
          "label": "Middle Left"
        },
        {
          "value": "middle-center",
          "label": "Middle Center"
        },
        {
          "value": "middle-right",
          "label": "Middle Right"
        },
        {
          "value": "bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom Center"
        },
        {
          "value": "bottom-right",
          "label": "Bottom Right"
        }
      ],
      "default": "top-center",
      "label":"Content Alignment"
    },
    {
      "type": "select",
      "id": "mobile_content_alignment",
      "options": [
        {
          "value": "mobile_top-left",
          "label": "Top Left"
        },
        {
          "value": "mobile_top-center",
          "label": "Top Center"
        },
        {
          "value": "mobile_top-right",
          "label": "Top Right"
        },
        {
          "value": "mobile_middle-left",
          "label": "Middle Left"
        },
        {
          "value": "mobile_middle-center",
          "label": "Middle Center"
        },
        {
          "value": "mobile_middle-right",
          "label": "Middle Right"
        },
        {
          "value": "mobile_bottom-left",
          "label": "Bottom Left"
        },
        {
          "value": "mobile_bottom-center",
          "label": "Bottom Center"
        },
        {
          "value": "mobile_bottom-right",
          "label": "Bottom Right"
        }
      ],
      "default": "mobile_middle-center",
      "label":"Mobile Content Alignment"
