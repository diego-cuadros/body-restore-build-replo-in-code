{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{section.id}} .tooltip {position: relative;display: inline-block;}
  #shopify-section-{{section.id}} .tooltip .tooltiptext {visibility: hidden;width: 220px;font-size:12px;font-weight:500;background-color: #000000;color: #fff;text-align: center;border-radius: 6px;padding: 10px 8px;position: absolute;z-index: 1;bottom: 125%;left: 50%;transform:translateX(-50%);margin-left: 0px;opacity: 0;transition: opacity 0.3s;}
  #shopify-section-{{section.id}} .tooltip .tooltiptext::after {content: "";position: absolute;top: 100%;left: 50%;margin-left: -5px;border-width: 5px;border-style: solid;border-color: #000000 transparent transparent transparent;}
  #shopify-section-{{section.id}} .tooltip:hover .tooltiptext {visibility: visible;opacity: 1;}
  #shopify-section-{{section.id}} .review-summary-container {max-width:500px;width:100%;margin:auto;padding:20px 0px;}
  #shopify-section-{{section.id}} .review-summary-container .inner-container {width:100%;}
  #shopify-section-{{section.id}} .review-summary-container .inner-container h3{margin-bottom:8px;display:flex;flex-direction:row;align-items:center;justify-content:center;gap:6px;font-size:18px;font-weight:700;color:#0c2331;}
  #shopify-section-{{section.id}} .review-summary-container .inner-container h3 .icon-star {position:relative;display:flex;flex-direction:row;align-items:center;justify-content:center;width:18px;min-width:18px;height:18px;}
  #shopify-section-{{section.id}} .review-summary-container .inner-container h3 .icon-star svg {width:100%;height:100%;object-fit:contain;}
  #shopify-section-{{section.id}} .review-summary-container .inner-container p {font-weight:500;font-size:14px;color:#0c2331;line-height:1.4;}

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient isolate">
  <div class="page-width section-{{ section.id }}-padding">
    {% render 'okendo-reviews-widget' %}
  </div>
</div>
{% comment %}
  <script>
          $(document).ready(function() {
              // Define the HTML content to be added
              var htmlContent = `
                  <div class="review-summary-container">
                  <div class="inner-container">
                      <h3>{{section.settnigs.summaryheading}} <span class="icon-star tooltip"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><!--! Font Awesome Pro 6.4.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license (Commercial License) Copyright 2023 Fonticons, Inc. --><path d="M432 32c8.8 0 16 7.2 16 16V96h48c8.8 0 16 7.2 16 16s-7.2 16-16 16H448v48c0 8.8-7.2 16-16 16s-16-7.2-16-16V128H368c-8.8 0-16-7.2-16-16s7.2-16 16-16h48V48c0-8.8 7.2-16 16-16zm0 288c8.8 0 16 7.2 16 16v48h48c8.8 0 16 7.2 16 16s-7.2 16-16 16H448v48c0 8.8-7.2 16-16 16s-16-7.2-16-16V416H368c-8.8 0-16-7.2-16-16s7.2-16 16-16h48V336c0-8.8 7.2-16 16-16zM136.8 216.4L54.2 254.6l82.6 38.1c6.9 3.2 12.4 8.7 15.6 15.6l38.1 82.6 38.1-82.6c3.2-6.9 8.7-12.4 15.6-15.6l82.6-38.1-82.6-38.1c-6.9-3.2-12.4-8.7-15.6-15.6l-38.1-82.6-38.1 82.6c-3.2 6.9-8.7 12.4-15.6 15.6zM123.4 321.8L9.3 269.1C3.6 266.5 0 260.8 0 254.6s3.6-11.9 9.3-14.5l114.1-52.7L176 73.3c2.6-5.7 8.3-9.3 14.5-9.3s11.9 3.6 14.5 9.3l52.7 114.1L371.8 240c5.7 2.6 9.3 8.3 9.3 14.5s-3.6 11.9-9.3 14.5L257.8 321.8 205.1 435.8c-2.6 5.7-8.3 9.3-14.5 9.3s-11.9-3.6-14.5-9.3L123.4 321.8z"></path></svg>
                        <span class="tooltiptext"> Generated by AI from 100 most recent customer reviews Last updated 3 months ago</span>
                      </span></h3>
                      <p>
                          Customers say this soap dish helps organize their shower bars and promotes drainage. Many reviews mention installation challenges with suction cups, though some report successful wall mounting. The compact design earns praise for space efficiency and bar organization.
                      </p>
                  </div>
                  </div>
              `;

              // Function to add content and tooltip
              function addContentAndTooltip() {
                  // Append the HTML content to the element with class 'oke-w-breakdownModule'
                  $('.oke-w-breakdownModule').append(htmlContent);

                  // Add tooltip to the span
                  $('.oke-w-breakdownModule span').attr('title', 'This is a tooltip');
              }

              // MutationObserver to detect when the element is added to the DOM
              const observer = new MutationObserver(function(mutationsList, observer) {
                  // Check if the target element (.oke-w-breakdownModule) exists
                  if ($('.oke-w-breakdownModule').length > 0) {
                      // Add content and tooltip
                      addContentAndTooltip();

                      // Stop observing once the element is found
                      observer.disconnect();
                  }
              });

              // Start observing the document body for changes
              observer.observe(document.body, {
                  childList: true, // Observe direct children
                  subtree: true // Observe all descendants
              });
          });
  </script>
{% endcomment %}
{% schema %}
{
  "name": "Review Widget",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "info": "t:sections.all.colors.has_cards_info",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 36
    }
  ],
  "presets": [
    {
      "name": "Review Widget"
    }
  ]
}
{% endschema %}

