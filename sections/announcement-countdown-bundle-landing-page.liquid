<script>
  function getStickyOffsetTop() {
    let offsetTop = 0;

    $('.announcement-bar-container').parents('.shopify-section').each(function () {
      const $el = $(this);
      const rect = this.getBoundingClientRect();
      const style = window.getComputedStyle(this);

      // If the element is at the top of the viewport and is sticky
      if (Math.round(rect.top) === 0 && style.position === 'sticky') {
        offsetTop += rect.height;
      }
    });

    return offsetTop;
  }

  function updateStickyTop(selector) {
    const offset = getStickyOffsetTop();
    $(selector).css('top', offset + 'px');
  }
   updateStickyTop(' #shopify-section-{{ section.id }}');
  // On page load
  $(document).on('ready', function () {
    updateStickyTop(' #shopify-section-{{ section.id }}');
  });

  // Optional: if other sticky elements appear on scroll
  $(window).on('scroll', function () {
    updateStickyTop(' #shopify-section-{{ section.id }}');
  });
</script>