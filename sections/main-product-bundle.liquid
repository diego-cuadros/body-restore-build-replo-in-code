<select style="display:none;" class="select-box-prod-val">
  {% for variant in product.variants %}
    <option data-id="{{ variant.id }}" data-qty="{{ variant.metafields.custom.cost_per_item }}"></option>
  {% endfor %}
</select>

<script>
    $(window).on('load', function(){
      setTimeout(function(){
          var data_id = $('product-form.product-form form input[name="id"]').val();
      var data_qty = $('.select-box-prod-val option[data-id="'+data_id+'"]').attr('data-qty');
      $('.unitpriceblock span').text('$ '+data_qty+' per tablet');
        }, 150)
      $('.product-form__input label').on('click', function(){
        setTimeout(function(){
          var data_id = $('product-form.product-form form input[name="id"]').val();
      var data_qty = $('.select-box-prod-val option[data-id="'+data_id+'"]').attr('data-qty');
      $('.unitpriceblock span').text('$ '+data_qty+' per tablet');
        }, 150)
      })
    })

  $(".add_cart_bundle").click(function(e) {
      e.preventDefault();
      var vals = [];
      var qtys = [];
      $(this).parents(".bundle_product").find(".product_data").each(function() {
          var id = $(this).find('input[name="id"]').val();
          console.log(id);
          vals.push(id); // Push the id value into the vals array
          var qty = $(this).find('input[name="quantity"]').val();
          console.log(qty);
          qtys.push(qty);
      });

      console.log("ids: " + vals); // Optional: to check the array of values
      console.log("qtys: " + qtys);

      var dataToSend = [];
      for (var i = 0; i < vals.length; i++) {
          dataToSend.push({
              id: vals[i],
              quantity: qtys[i]
          });
      }

      console.log("Data to send:", dataToSend);
      this.cart = document.querySelector('cart-notification') || document.querySelector('cart-drawer');
      $.ajax({
          type: 'POST',
          url: '/cart/add.js',
          contentType: 'application/json',
          data: JSON.stringify({ items: dataToSend }),
          success: function(){
              console.log("Add to cart successful");
              // Remaining code for updating UI after successful addition to cart

             $('cart-drawer').removeClass('is-empty');
                $('.drawer__inner-empty').hide();
                $('cart-drawer').load(location.href + " #CartDrawer");
              $(".cart_item_clear_btn").addClass("active");
                setTimeout(function(){
                  $(".cart_item_clear_btn").addClass("active");
                  $(".drawer").addClass('active animate');
                  $(".drawer__header").click(function(e){
                    e.preventDefault();
                    console.log("adsasdasd");
                  });
                },1000);

                  jQuery.getJSON('/cart.js', function(cart) {
                    if(cart.item_count > 0){
                      console.log(cart.item_count);
                      $(".header__icon .cart-count-bubble span:first-child").text(cart.item_count);
                    }
                  });
          },
          error: function(){
              console.log("Error adding to cart");
          }
      });
  });
</script>
